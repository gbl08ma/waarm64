+   struct vkr_device_memory *a = calloc(1, sizeof(*a)), *b = calloc(1, sizeof(*b));
+   a->base.handle.device_memory = b->base.handle.device_memory = memory;
+   a->wasi_storage = res->storage;
+   a->wasi_res = res;
