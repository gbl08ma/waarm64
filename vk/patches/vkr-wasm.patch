+vkr_wasi_count_cmd(const struct vkr_cs_decoder *dec, int where)
+{
+   if (dec->end - dec->cur < 8)
+      return;
+   uint32_t type, flags;
+   __builtin_memcpy(&type, dec->cur, 4);
