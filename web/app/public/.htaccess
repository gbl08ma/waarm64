# Apache (mod_headers): the page needs cross-origin isolation.
Header always set Cross-Origin-Opener-Policy "same-origin"
Header always set Cross-Origin-Embedder-Policy "require-corp"
AddType application/wasm .wasm
AddType text/javascript .js .mjs
# The guest agent's gzip (assets/waarm64-agent-<hash>.gz) as the bytes it is: no Content-Encoding (the page hands it
# to the guest compressed).
RemoveEncoding .gz
AddType application/gzip .gz
