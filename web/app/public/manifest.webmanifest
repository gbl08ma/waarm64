{
  "id": "/",
  "name": "waarm64",
  "short_name": "waarm64",
  "description": "A whole-system AArch64 emulator that runs in your browser: unmodified ARM Linux, compiled to WebAssembly as it runs.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#262624",
  "background_color": "#262624",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "launch_handler": { "client_mode": "focus-existing" },
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "application/x-qemu-disk": [".qcow2"],
        "application/x-raw-disk-image": [".img", ".raw"],
        "application/x-cd-image": [".iso"],
        "application/x-waarm64-snapshot": [".waarm64snap"]
      },
      "launch_type": "single-client"
    }
  ]
}
