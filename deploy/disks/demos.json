   "thumbnail": "target/demos/alpine-term/thumb.webp",
   "recipe": {
    "image": "alpine-demo",
    "machine": {
     "name": "Alpine",
     "ncpus": 2,
     "ramMiB": 512,
     "keyboard": "browser",
     "display": "2d",
