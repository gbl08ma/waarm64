      "seconds": 10
     }
    }
   },
   "demo": {
    "id": "arch-desktop",
    "summary": "Arch Linux's sway desktop, started as the machine resumes, with a terminal open; Firefox starts a few seconds later (Ctrl+C in the terminal stops it). Its network reaches only Alpine's package mirror (dl-cdn.alpinelinux.org) for now: Firefox can't open websites, and pacman can't reach Arch's mirror.",
    "view": "screen",
    "network": "demo",
    "room": "global"
   }
  },
