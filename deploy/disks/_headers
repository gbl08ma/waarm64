# Copied into target/disks/ by deploy.sh. CORS for any page (the page is cross-origin isolated: a response without
# CORS doesn't reach it); pieces are named by their hash, so they never change; manifests do.
/*
  Access-Control-Allow-Origin: *
  Access-Control-Expose-Headers: Content-Length, ETag
/:image/pieces/*
  Cache-Control: public, max-age=31536000, immutable
/*.json
  Cache-Control: public, max-age=300
