diff --git a/core/src/interp/sys.rs b/core/src/interp/sys.rs
index 346cda4..58467d4 100644
--- a/core/src/interp/sys.rs
+++ b/core/src/interp/sys.rs
@@ -599,6 +599,14 @@ pub fn timer_fires(ctl: u64, cval: u64, now: u64) -> bool {
 
 /// Whether the [`Exit::Platform`] access `i` is an `RNDR` or `RNDRRS` read,
 /// which the run loop completes with [`rndr`], not [`platform`].
+pub fn xcount(i: u32, el: u64) -> usize {
+    match bits(i, 20, 5) {
+        CNTPCT | CNTVCT if el == 0 => 0x3f,
+        CNTPCT | CNTVCT => 0x3e,
+        _ => 0x3d,
+    }
+}
+
 pub fn is_rndr(i: u32) -> bool {
     matches!(bits(i, 20, 5), RNDR | RNDRRS)
 }
