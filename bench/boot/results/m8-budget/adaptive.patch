+/// The marks of an adaptive budget's probe ([`Cache::probe`]): the sweep the
+/// dispatchers mark with (0: none running), and per slot the last sweep that
+/// entered it from a dispatcher; slot `s` is table index `base + s`.
+pub struct Marks {
+    sweep: AtomicU32,
+    base: AtomicU32,
+    words: Box<[AtomicU32]>,
+}
+
+impl Marks {
+    fn new(slots: usize) -> Marks {
+        Marks {
+            sweep: AtomicU32::new(0),
+            base: AtomicU32::new(u32::MAX),
+            words: (0..slots).map(|_| AtomicU32::new(0)).collect(),
+        }
+    }
+
+    /// Table index `idx` was entered from a dispatcher during sweep `sweep`
+    /// (stored once a sweep, so the line isn't written back and forth).
+    #[inline(always)]
+    fn mark(&self, idx: u32, sweep: u32) {
+        let s = idx.wrapping_sub(self.base.load(Ordering::Relaxed)) as usize;
+        if let Some(w) = self.words.get(s)
+            && w.load(Ordering::Relaxed) != sweep
+        {
+            w.store(sweep, Ordering::Relaxed);
+        }
+    }
+}
