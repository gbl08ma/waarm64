+  assert.ok(through <= 22, `${through} transfers through the table for 20 laps`);
+  l3[1] = 0x2000n | PTE;
+  run(0x403000n);
+  const x2 = x[2];
+  run(0x400000n, 10n);
+  assert.equal(x[2] - x2, 50n);
+});
