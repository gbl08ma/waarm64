+/// The diagnostic build: a host call's return that landed elsewhere than the
+/// call's continuation `cont`.
+///
+/// # Safety
+/// As for [`jit_exec_flat`].
+#[cfg(feature = "diag")]
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn jit_diag_ret(v: *mut Vcpu, cont: u64) {
+    // SAFETY: guaranteed by the caller.
+    let (mem, v) = unsafe { (&*(*v).jit.mem, &mut *v) };
+    let ret = v.diag[15];
+    let pc = v.cpu.pc;
+    let asid = v.cpu.ttbr0_el1 >> 48 | (v.cpu.el() as u64) << 20;
+    let mut word = |va: u64| -> String {
+        if v.cpu.sctlr_el1 & sctlr::M == 0 {
+            return "-".into();
+        }
+        match Mmu::new(mem, Some(&mut v.tlb)).fetch_ptr(&v.cpu, va) {
+            Ok(p) => mem
+                .read(mem.pa(p), 4)
+                .map_or("?".into(), |w| format!("{w:08x}")),
+            Err(_) => "f".into(),
+        }
+    };
+    let key = (ret, cont, pc, asid);
+    let new = !v.jit.cache.as_deref().expect("jit").table.dret.contains_key(&key);
+    let w = if new {
+        let mut s = String::new();
+        // The RET's block, the call before the continuation, around the PC.
+        for a in (0..16).rev() {
+            s.push_str(&word(ret.wrapping_sub(4 * a)));
+            s.push('.');
+        }
+        s.push('|');
+        s.push_str(&word(cont.wrapping_sub(4)));
+        s.push('|');
+        for a in [-8i64, -4, 0, 4] {
+            s.push_str(&word(pc.wrapping_add(a as u64)));
+            s.push('.');
+        }
+        s.push_str(&format!("|x30={:x}", v.cpu.x[30]));
+        s
+    } else {
+        String::new()
+    };
+    let t = &mut v.jit.cache.as_deref_mut().expect("jit").table;
+    let e = t.dret.entry(key).or_insert((0, w));
+    e.0 += 1;
+}
