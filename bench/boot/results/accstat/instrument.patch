new file mode 100644
index 00000000..cc8036ee
--- /dev/null
+++ b/core/examples/accstat.rs
@@ -0,0 +1,334 @@
+//! accstat <dump>: what groups of accesses reach on a measured session (the instrumented core's dump).
+use std::collections::HashMap;
+use webpc_core::decode::{Op, decode};
+use webpc_core::jit::emit::{Bus, Ctx, between, shape, tlb_array};
+
+const fn bits(i: u32, h: u32, l: u32) -> u32 {
+    (i >> l) & ((1u64 << (h - l + 1)) - 1) as u32
+}
+
+const CX: Ctx = Ctx {
+    helper: 0,
+    bus: Bus::Tlb { read: tlb_array(1, 0) },
+    el1: true,
+    crypto: true,
+    sha3: true,
+    parallel: true,
+    pair_locks: 0x100,
+    clock: None,
+    spill: 0,
+    groups: true,
+};
+
+/// A variant of the plan.
+#[derive(Clone, Copy)]
+struct V {
+    name: &'static str,
+    span: i64,
+    /// Others allowed: fewer than the probes saved (`false`), or any `max_others`.
+    free: bool,
+    max_others: usize,
+    /// Loads and stores of a base share an entry (one probe, of the write array).
+    mixed: bool,
+    /// Probes at the leader.
+    bases: usize,
+    /// Any non-access may sit between (the bound on widening `between`).
+    any: bool,
+}
+
+#[derive(Clone, Copy, Default)]
+struct R {
+    probes_d: f64,
+    probes_s: f64,
+    groups_d: f64,
+    in_groups_d: f64,
+    groups_s: f64,
+    in_groups_s: f64,
+    others_d: f64,
+    others_s: f64,
+    /// Group runs × P(the span straddles a page).
+    strad_d: f64,
+    /// Group runs by span/16 (static excluded).
+    span_d: [f64; 18],
+}
+
+struct Entry {
+    rn: u32,
+    write: bool,
+    lo: i64,
+    hi: i64,
+}
+
+/// One block under `v`: adds to r.
+fn run(words: &[u32], w: f64, v: &V, p: &[f64; 257], r: &mut R, ends: &mut HashMap<String, f64>) {
+    let mut k = 0;
+    while k < words.len() {
+        let Some(s) = shape(words[k]) else {
+            k += 1;
+            continue;
+        };
+        // Registers changed in the span: delta from the leader's value, None unknown.
+        let mut regs: HashMap<u32, Option<i64>> = HashMap::new();
+        let mut es = vec![Entry { rn: s.rn, write: s.write, lo: s.off, hi: s.off + s.len as i64 }];
+        regs.insert(s.rn, Some(s.wb));
+        if s.loads & 1 << s.rn != 0 {
+            k += 1;
+            r.probes_d += w;
+            r.probes_s += 1.0;
+            continue;
+        }
+        for b in 0..31 {
+            if s.loads & 1 << b != 0 {
+                regs.insert(b, None);
+            }
+        }
+        let (mut n, mut others) = (1usize, 0usize);
+        let mut best: Option<(usize, usize, usize, Vec<(i64, i64)>)> = None; // last, n, others, spans
+        let mut j = k + 1;
+        while j < words.len() {
+            let i = words[j];
+            if let Some(t) = shape(i) {
+                let d = match regs.get(&t.rn) {
+                    None => 0,
+                    Some(Some(d)) => *d,
+                    Some(None) => break,
+                };
+                if t.rn == 31 && d % 16 != 0 {
+                    break;
+                }
+                let a = d.wrapping_add(t.off);
+                let at = es.iter().position(|e| e.rn == t.rn && (v.mixed || e.write == t.write));
+                match at {
+                    Some(x) => {
+                        let e = &mut es[x];
+                        let (l, h) = (e.lo.min(a), e.hi.max(a + t.len as i64));
+                        if h - l > v.span {
+                            break;
+                        }
+                        (e.lo, e.hi) = (l, h);
+                        e.write |= t.write;
+                    }
+                    None => {
+                        if es.len() == v.bases {
+                            break;
+                        }
+                        es.push(Entry { rn: t.rn, write: t.write, lo: a, hi: a + t.len as i64 });
+                    }
+                }
+                n += 1;
+                let saved = n - es.len();
+                let ok = if v.free { others <= v.max_others } else { others < saved };
+                if saved > 0 && ok {
+                    best = Some((j, n, others, es.iter().map(|e| (e.lo, e.hi)).collect()));
+                }
+                regs.insert(t.rn, Some(d.wrapping_add(t.wb)));
+                for b in 0..31 {
+                    if t.loads & 1 << b != 0 {
+                        regs.insert(b, None);
+                    }
+                }
+            } else {
+                let mut z = 0;
+                let op = decode(i);
+                let access = (i >> 25) & 5 == 4;
+                if !(between(i, j, &CX, 99, &mut z) || (v.any && !access)) {
+                    let later = words[j + 1..].iter().take(12).any(|&x| shape(x).is_some_and(|t| es.iter().any(|e| e.rn == t.rn)));
+                    if later {
+                        *ends.entry(format!("{op:?}")).or_default() += w;
+                    }
+                    break;
+                }
+                let (rd, rs) = (bits(i, 4, 0), bits(i, 9, 5));
+                if op != Op::NOP {
+                    let self_add = matches!(op, Op::ADD_imm | Op::SUB_imm) && rd == rs && i >> 31 == 1;
+                    if self_add {
+                        let imm = (bits(i, 21, 10) as i64) << (12 * bits(i, 23, 22));
+                        let imm = if op == Op::ADD_imm { imm } else { -imm };
+                        let d = regs.get(&rd).copied().unwrap_or(Some(0));
+                        regs.insert(rd, d.map(|d| d + imm));
+                    } else {
+                        regs.insert(rd, None);
+                    }
+                }
+                others += 1;
+            }
+            j += 1;
+        }
+        match best {
+            None => {
+                r.probes_d += w;
+                r.probes_s += 1.0;
+                k += 1;
+            }
+            Some((last, n, others, spans)) => {
+                r.probes_d += w * spans.len() as f64;
+                r.probes_s += spans.len() as f64;
+                r.groups_d += w;
+                r.groups_s += 1.0;
+                r.in_groups_d += w * n as f64;
+                r.in_groups_s += n as f64;
+                r.others_d += w * others as f64;
+                r.others_s += others as f64;
+                let mut ps = 1.0;
+                for (lo, hi) in &spans {
+                    let span = (hi - lo) as usize;
+                    r.span_d[(span / 16).min(17)] += w;
+                    ps *= 1.0 - p[(span / 16).min(256)];
+                }
+                r.strad_d += w * (1.0 - ps);
+                k = last + 1;
+            }
+        }
+    }
+}
+
+fn main() {
+    let path = std::env::args().nth(1).expect("dump");
+    let b = std::fs::read(path).unwrap();
+    let u64s = |at: usize, n: usize| -> Vec<u64> { (0..n).map(|i| u64::from_le_bytes(b[at + 8 * i..at + 8 * i + 8].try_into().unwrap())).collect() };
+    let u32at = |at: usize| u32::from_le_bytes(b[at..at + 4].try_into().unwrap());
+    let (blocks, nwords) = (u32at(0) as usize, u32at(4) as usize);
+    let hist = u64s(8, 256);
+    let hist1 = u64s(8 + 8 * 256, 256);
+    let cold = u64s(8 + 8 * 512, 32);
+    let strad = u64s(8 + 8 * 544, 32);
+    let same = u64s(8 + 8 * 576, 8);
+    let head = 8 + 8 * 584;
+    let blocks = blocks.min(1 << 20);
+    let count = u64s(head, blocks);
+    let log = head + 8 * blocks;
+    let nwords = nwords.min(3 << 22).min((b.len() - log) / 4);
+    let mut at = 0;
+    let mut list: Vec<(Vec<u32>, f64, u64)> = vec![];
+    while at + 6 <= nwords {
+        let id = u32at(log + 4 * at) as usize;
+        let len = u32at(log + 4 * at + 4) as usize;
+        if len == 0 && id == 0 && at > 0 {
+            at += 6;
+            continue;
+        }
+        let key = u32at(log + 4 * at + 8) as u64 | (u32at(log + 4 * at + 12) as u64) << 32;
+        let w: Vec<u32> = (0..len).map(|i| u32at(log + 4 * (at + 6 + i))).collect();
+        if id < blocks {
+            list.push((w, count[id] as f64, key));
+        }
+        at += 6 + len;
+    }
+    // P(straddle) of a span of (index × 16) bytes, from the single accesses' and groups' offsets.
+    let tot: f64 = hist.iter().chain(hist1.iter()).map(|&x| x as f64).sum();
+    let tg: f64 = hist.iter().map(|&x| x as f64).sum();
+    let mut p = [0f64; 257];
+    for s in 0..=256usize {
+        let span = 16 * s;
+        p[s] = hist.iter().enumerate().filter(|&(o, _)| 16 * o + span > 4096).map(|(_, &x)| x as f64).sum::<f64>() / tg.max(1.0);
+    }
+    println!("blocks {} log words {nwords} mmu blocks {}", list.len(), list.iter().filter(|b| b.2 & 2 != 0 || true).count());
+    // The mix.
+    let (mut steps, mut acc, mut sh, mut reg, mut lit, mut st, mut other) = (0f64, 0f64, 0f64, 0f64, 0f64, 0f64, 0f64);
+    let (mut sacc, mut sreg, mut slit, mut sst, mut sother) = (0f64, 0f64, 0f64, 0f64, 0f64);
+    let mut ldst_d = [0f64; 2];
+    let mut opc: HashMap<String, f64> = HashMap::new();
+    for (ws, w, _) in &list {
+        steps += w * ws.len() as f64;
+        for &i in ws {
+            if let Some(s) = shape(i) {
+                sh += w;
+                sacc += 1.0;
+                ldst_d[s.write as usize] += w;
+                continue;
+            }
+            if (i >> 25) & 5 != 4 {
+                continue;
+            }
+            acc += w;
+            let op = decode(i);
+            *opc.entry(format!("{op:?}")).or_default() += w;
+            if matches!(op, Op::STRx_reg | Op::LDRx_reg | Op::STR_reg_fpsimd | Op::LDR_reg_fpsimd) {
+                reg += w;
+                sreg += 1.0;
+            } else if bits(i, 29, 27) == 3 && bits(i, 24, 24) == 0 {
+                lit += w;
+                slit += 1.0;
+            } else if bits(i, 31, 31) == 0 && bits(i, 29, 24) == 0b001100 {
+                st += w;
+                sst += 1.0;
+            } else {
+                other += w;
+                sother += 1.0;
+            }
+        }
+    }
+    let all = sh + acc;
+    println!("instructions {:.3e}; load/store class {:.3e} ({:.1}%)", steps, all, 100.0 * all / steps);
+    println!("  imm forms {:.1}% (loads {:.3e}, stores {:.3e}), static {sacc}", 100.0 * sh / all, ldst_d[0], ldst_d[1]);
+    println!("  reg offset {:.1}%, static {sreg}", 100.0 * reg / all);
+    println!("  literal {:.1}%, static {slit}", 100.0 * lit / all);
+    println!("  LD/ST structures {:.1}%, static {sst}", 100.0 * st / all);
+    println!("  other (exclusive, acquire, atomics, PRFM…) {:.1}%, static {sother}", 100.0 * other / all);
+    let mut o: Vec<_> = opc.into_iter().collect();
+    o.sort_by(|a, b| b.1.total_cmp(&a.1));
+    for (k, v) in o.iter().take(12) {
+        println!("    {k} {:.1}%", 100.0 * v / all);
+    }
+    let sm: f64 = same.iter().map(|&x| x as f64).sum();
+    println!("probes run {sm:.3e}: reads same page as last/prev/other {:.1}/{:.1}/{:.1}%, writes {:.1}/{:.1}/{:.1}%",
+        100.0 * same[0] as f64 / sm, 100.0 * same[1] as f64 / sm, 100.0 * same[2] as f64 / sm,
+        100.0 * same[4] as f64 / sm, 100.0 * same[5] as f64 / sm, 100.0 * same[6] as f64 / sm);
+    let (cs, ss): (u64, u64) = (cold.iter().sum(), strad.iter().sum());
+    println!("group runs {tg:.3e} (of hist total {tot:.3e}); cold arms {cs} ({:.2}%), straddling {ss} ({:.2}%)", 100.0 * cs as f64 / tg, 100.0 * ss as f64 / tg);
+    println!("  cold/straddle by span/16: {:?}", (0..32).filter(|&i| cold[i] > 0).map(|i| (i * 16, cold[i], strad[i])).collect::<Vec<_>>());
+    let top: Vec<(usize, f64)> = (0..256).map(|i| (i, 100.0 * hist[i] as f64 / tg)).collect();
+    println!("  groups' offset: last 256 B of a page {:.2}%, first 256 B {:.2}%, uniform 6.25%", top[240..].iter().map(|x| x.1).sum::<f64>(), top[..16].iter().map(|x| x.1).sum::<f64>());
+    println!("  predicted straddle by span: {}", [16, 32, 48, 64, 96, 128, 192, 256, 512, 1024].iter().map(|&s| format!("{s}:{:.2}%", 100.0 * p[s / 16])).collect::<Vec<_>>().join(" "));
+    let d = |name, span, free, max_others, mixed, bases| V { name, span, free, max_others, mixed, bases, any: false };
+    let vs = [
+        d("none (every access probes)", 0, false, 0, false, 1),
+        d("today: 256", 256, false, 0, false, 1),
+        d("span 32", 32, false, 0, false, 1),
+        d("span 64", 64, false, 0, false, 1),
+        d("span 128", 128, false, 0, false, 1),
+        d("span 512", 512, false, 0, false, 1),
+        d("span 1024", 1024, false, 0, false, 1),
+        d("span 4096", 4096, false, 0, false, 1),
+        d("256, others free ≤4", 256, true, 4, false, 1),
+        d("256, others free ≤16", 256, true, 16, false, 1),
+        d("256, mixed", 256, false, 0, true, 1),
+        d("256, 2 probes", 256, false, 0, false, 2),
+        d("256, 2 probes mixed", 256, false, 0, true, 2),
+        d("256, 3 probes mixed", 256, false, 0, true, 3),
+        d("256, mixed, free ≤4", 256, true, 4, true, 1),
+        d("256, 2 mixed, free ≤4", 256, true, 4, true, 2),
+        d("256, 2 mixed, free ≤16", 256, true, 16, true, 2),
+        d("256, 3 mixed, free ≤16", 256, true, 16, true, 3),
+        V { any: true, ..d("any between, ≤16", 256, true, 16, false, 1) },
+        V { any: true, ..d("any, mixed, ≤16", 256, true, 16, true, 1) },
+        V { any: true, ..d("any, 2 mixed, ≤16", 256, true, 16, true, 2) },
+        V { any: true, ..d("any, 3 mixed, ≤16", 256, true, 16, true, 3) },
+        V { any: true, ..d("any, 3 mixed, ≤32", 256, true, 32, true, 3) },
+    ];
+    println!("{:28} {:>8} {:>7} {:>8} {:>7} {:>7} {:>7} {:>7} {:>7}", "variant", "probes", "probes", "groups", "mean", "others", "others", "strad", "strad");
+    println!("{:28} {:>8} {:>7} {:>8} {:>7} {:>7} {:>7} {:>7} {:>7}", "", "dyn %", "stat %", "dyn/acc", "dyn", "dyn/g", "stat/g", "% run", "/1k acc");
+    for v in &vs {
+        let mut r = R::default();
+        let mut ends = HashMap::new();
+        for (ws, w, _) in &list {
+            if v.span == 0 {
+                let n = ws.iter().filter(|&&i| shape(i).is_some()).count() as f64;
+                r.probes_d += w * n;
+                r.probes_s += n;
+            } else {
+                run(ws, *w, v, &p, &mut r, &mut ends);
+            }
+        }
+        println!("{:28} {:>8.1} {:>7.1} {:>8.3} {:>7.2} {:>7.2} {:>7.2} {:>7.2} {:>7.2}", v.name,
+            100.0 * r.probes_d / sh, 100.0 * r.probes_s / sacc, r.groups_d / sh, r.in_groups_d / r.groups_d.max(1.0),
+            r.others_d / r.groups_d.max(1.0), r.others_s / r.groups_s.max(1.0), 100.0 * r.strad_d / r.groups_d.max(1.0), 1000.0 * r.strad_d / sh);
+        if v.name == "256, 2 mixed, free ≤16" {
+            let mut e: Vec<_> = ends.into_iter().collect();
+            e.sort_by(|a, b| b.1.total_cmp(&a.1));
+            let t: f64 = e.iter().map(|x| x.1).sum();
+            println!("    what ends groups with a same-base access within 12 ({:.1}% of accesses): {}", 100.0 * t / sh,
+                e.iter().take(24).map(|(k, x)| format!("{k} {:.1}", 100.0 * x / t)).collect::<Vec<_>>().join(", "));
+        }
+    }
+}
