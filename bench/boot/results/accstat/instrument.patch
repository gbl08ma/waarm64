+//! Measurement only (bench/boot/results/accstat): each compiled block's words and execution count, and
+//! accesses' page offsets, for `examples/accstat.rs`. Not built on main.
+use core::sync::atomic::{AtomicPtr, AtomicU32, Ordering};
+
+pub const MAX_BLOCKS: usize = 1 << 20;
+pub const LOG_WORDS: usize = 3 << 22;
+
+#[repr(C)]
+pub struct Acc {
+    pub next_block: AtomicU32,
+    pub next_word: AtomicU32,
+    /// The group's lowest address's page offset / 16, at each run of a group.
+    pub hist: [u64; 256],
+    /// The same for a single probed access.
+    pub hist1: [u64; 256],
+    /// A group's cold arm runs by span / 16; those whose span straddles a page.
+    pub cold: [u64; 32],
+    pub strad: [u64; 32],
+    /// Probes (+4 for writes): on the page of the function's last probe, the one before, another.
+    pub same: [u64; 8],
+    pub count: [u64; MAX_BLOCKS],
+    pub log: [u32; LOG_WORDS],
+}
+
+static P: AtomicPtr<Acc> = AtomicPtr::new(core::ptr::null_mut());
+
+pub fn get() -> &'static Acc {
+    let mut p = P.load(Ordering::Acquire);
+    if p.is_null() {
+        let l = core::alloc::Layout::new::<Acc>();
+        // SAFETY: a non-zero layout; all-zero bytes are a valid Acc.
+        let n = unsafe { std::alloc::alloc_zeroed(l) }.cast::<Acc>();
+        p = match P.compare_exchange(core::ptr::null_mut(), n, Ordering::AcqRel, Ordering::Acquire) {
+            Ok(_) => n,
+            Err(q) => q,
+        };
+    }
+    // SAFETY: leaked, shared by the threads of one memory.
+    unsafe { &*p }
+}
+
+/// Logs a block; its id, its count's index. u32::MAX if the tables are full.
+pub fn block(key: u64, va: u64, words: &[u32]) -> u32 {
+    let a = get();
+    let n = 6 + words.len() as u32;
+    let at = a.next_word.fetch_add(n, Ordering::Relaxed) as usize;
+    let id = a.next_block.fetch_add(1, Ordering::Relaxed);
+    if at + n as usize > LOG_WORDS || id as usize >= MAX_BLOCKS {
+        return u32::MAX;
+    }
+    let l = a.log.as_ptr().cast_mut();
+    let head = [id, words.len() as u32, key as u32, (key >> 32) as u32, va as u32, (va >> 32) as u32];
+    // SAFETY: [at, at + n) is this block's alone.
+    unsafe {
+        core::ptr::copy_nonoverlapping(head.as_ptr(), l.add(at), 6);
+        core::ptr::copy_nonoverlapping(words.as_ptr(), l.add(at + 6), words.len());
+    }
+    id
+}
+
+/// What a dump is: the pointer, then in the export's order.
+#[unsafe(no_mangle)]
+pub extern "C" fn accstat_ptr() -> *const Acc {
+    get()
+}
