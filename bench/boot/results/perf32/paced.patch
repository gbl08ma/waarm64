+    /// Paced chunks (PERF loop 32's switch): the chunk's steps for polled code, from the vCPU's measured rate and
+    /// its next timer deadline (`pace`): to a little before the deadline, at most [`PACE_MAX`] steps or ~1 ms;
+    /// [`CHUNK`] until the rate is known.
+    #[cfg(feature = "paced")]
+    fn paced(&self, own: &Own) -> u64 {
+        if own.rate == 0.0 {
+            return CHUNK;
+        }
+        let ms = (own.rate * self.cfg.cntfrq as f64 / 1000.0) as u64;
+        let mut n = own.due.saturating_sub(own.steps).min(ms).min(PACE_MAX);
+        // The xHCI's completions wait for a chunk's end (`run_loop`).
+        if self.shared.xhci_due.load(Ordering::Relaxed) != u64::MAX {
+            n = n.min(CHUNK);
+        }
+        n.max(PACE_MIN)
+    }
+
+    /// Paced chunks: the vCPU's rate (steps per counter tick, between two timer checks of one run) and the steps
+    /// at its next deadline, as of counter value `now`.
+    #[cfg(feature = "paced")]
+    fn pace(&self, v: &Vcpu, own: &mut Own, now: u64, last: &mut Option<(u64, u64)>) {
+        if let Some((s, t)) = *last
+            && now > t
+            && !own.wfi
+        {
+            let r = (own.steps - s) as f64 / (now - t) as f64;
+            own.rate = if own.rate == 0.0 {
+                r
+            } else {
+                (own.rate * 3.0 + r) / 4.0
+            };
+        }
+        *last = Some((own.steps, now));
+        own.due = match deadline(&v.cpu, now) {
+            // A little early: the rate is an estimate.
+            Some(t) if own.rate > 0.0 => {
+                own.steps + ((t - now) as f64 * own.rate * PACE_EARLY) as u64
+            }
+            _ => u64::MAX,
+        };
+    }
