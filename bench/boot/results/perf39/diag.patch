+        g[14].store(p.heads.len() as u64, Ordering::Relaxed);
+        g[15].store(
+            table_bytes(p.heads.capacity(), size_of::<(u64, Vec<u64>)>()) + hl + 8 * p.heads.len() as u64,
+            Ordering::Relaxed,
+        );
+    }
