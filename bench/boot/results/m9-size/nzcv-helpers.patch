+    /// The function imports of a module (its import section's entries of kind 0).
+    fn func_imports(m: &[u8]) -> u32 {
+        let uleb = |p: &mut usize| {
+            let (mut v, mut sh) = (0u64, 0);
+            loop {
+                let b = m[*p];
+                *p += 1;
+                v |= ((b & 0x7f) as u64) << sh;
+                sh += 7;
+                if b & 0x80 == 0 {
+                    return v;
+                }
+            }
+        };
+        let mut p = 8;
+        while p < m.len() {
+            let (id, size) = (m[p], {
+                p += 1;
+                uleb(&mut p) as usize
+            });
+            if id != 2 {
+                p += size;
+                continue;
+            }
+            let mut funcs = 0;
+            for _ in 0..uleb(&mut p) {
+                for _ in 0..2 {
+                    let n = uleb(&mut p) as usize;
+                    p += n;
+                }
+                let kind = m[p];
+                p += 1;
+                match kind {
+                    0 => {
+                        uleb(&mut p);
+                        funcs += 1;
+                    }
+                    1 => {
+                        p += 1; // the reftype
+                        let flags = m[p];
+                        p += 1;
+                        uleb(&mut p);
+                        if flags & 1 != 0 {
+                            uleb(&mut p);
+                        }
+                    }
+                    2 => {
+                        let flags = m[p];
+                        p += 1;
+                        uleb(&mut p);
+                        if flags & 1 != 0 {
+                            uleb(&mut p);
+                        }
+                    }
+                    _ => p += 2, // a global: its type and mutability
+                }
+            }
+            return funcs;
+        }
+        0
+    }
