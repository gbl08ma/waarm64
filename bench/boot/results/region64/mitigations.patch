+/// The blocks one plan forms ([`form`]), each read and decoded once: a
+/// forward region's walks again ([`forward`]), the loop regions of a batch's
+/// blocks and its candidates' loop checks reach the same blocks over and
+/// over. It lives for one plan, so it holds what memory held then; the
+/// compiled code is checked against memory as before (docs/jit.md
+/// "Invalidation and the stale-code checker").
+pub struct Forms<'a> {
+    mem: &'a Mem,
+    map: core::cell::RefCell<HashMap<u64, Vec<u32>, super::KeyBuild>>,
+}
+
+impl<'a> Forms<'a> {
+    pub fn new(mem: &'a Mem) -> Self {
+        Forms {
+            mem,
+            map: Default::default(),
+        }
+    }
+
+    /// [`form`]`(mem, pa)`, from the map once it's been formed.
+    pub fn get(&self, pa: u64) -> Vec<u32> {
+        if let Some(w) = self.map.borrow().get(&pa) {
+            return w.clone();
+        }
+        let w = form(self.mem, pa);
+        self.map.borrow_mut().insert(pa, w.clone());
+        w
+    }
+}
