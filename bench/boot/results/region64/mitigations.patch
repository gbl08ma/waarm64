+    /// Calls whose callees can leave the region, one after another, each walk
+    /// the region again; past [`WALKS`], a last walk follows none.
+    #[test]
+    fn the_walks_of_a_forward_region_are_bounded() {
+        // 0x100: bl 0x200; 0x104: bl 0x220; 0x108: bl 0x240; 0x10c: bl 0x260;
+        // 0x110: ret. Each callee: b 0x400 (not admitted).
+        let mut words = [0u32; 89];
+        words[..5].copy_from_slice(&[0x94000040, 0x94000047, 0x9400004e, 0x94000055, 0xd65f03c0]);
+        for (at, b) in [
+            (0x200, 0x14000080),
+            (0x220, 0x14000078),
+            (0x240, 0x14000070),
+            (0x260, 0x14000068),
+        ] {
+            words[(at - 0x100) / 4] = b;
+        }
+        let (_r, m) = mem_with(0x100, &words);
+        // A walk that follows a call reaches its callee's branch to 0x400.
+        let leaves = core::cell::Cell::new(0);
+        let r = forward(&m, 0x100, 0x100, &|va, k| {
+            leaves.set(leaves.get() + (va == 0x400) as usize);
+            k.filter(|&k| k != 0x400)
+        });
+        let keys: Vec<u64> = r.blocks.iter().map(|b| b.key).collect();
+        assert_eq!(keys, [0x100, 0x104, 0x108, 0x10c, 0x110]);
+        assert!(r.follows.is_empty() && r.open_call().is_none());
+        // Four calls open would take five walks: the bound took four, the last
+        // following none.
+        assert_eq!(leaves.get(), WALKS - 1);
+    }
