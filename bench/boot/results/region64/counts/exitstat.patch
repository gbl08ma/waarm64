+/// batch, no words, a reason not recorded).
+pub const WHY_FULL: u32 = 0;
+pub const WHY_HERE: u32 = 1;
+pub const WHY_LOOP: u32 = 2;
+pub const WHY_TAKEN: u32 = 3;
+pub const WHY_COMPILED: u32 = 4;
+pub const WHY_COLD: u32 = 5;
+pub const WHY_OPEN_CALL: u32 = 6;
+pub const WHY_LOOP_REGION: u32 = 7;
+pub const WHY_ALONE: u32 = 8;
+pub const WHY_OTHER: u32 = 9;
+/// The reason the last `member` refusal gave (single-threaded measurement runs only).
+pub static WHY: core::sync::atomic::AtomicU32 = core::sync::atomic::AtomicU32::new(WHY_OTHER);
 
