 /// Slots below this are compiled code's (copied from the vCPU's table at each publication).
 pub const JIT_SLOTS: usize = 16;
+/// EXITSTAT (measurement only): a second range of compiled code's slots, copied as the first.
+pub const JIT2: usize = 80;
+/// A static successor that left its region (`block::chain` reached), by why it isn't a member ([`WHY`]): a tail
+/// transfer at `XTAIL + why`, a host call (a BL's callee) at `XCALL + why`.
+pub const XTAIL: u32 = 80;
+pub const XCALL: u32 = 92;
+/// The reasons: the region had `REGION` blocks; the target is in the region already (an earlier member, or its
+/// VA taken); a loop head of the batch; another region of the batch took it (a head or a member); outside the batch,
+/// compiled before; outside the batch and not compiled (not hot yet); a call whose callee could leave the region
