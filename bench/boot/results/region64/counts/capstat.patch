@@ -784,6 +784,57 @@ struct Env<'a> {
     nzcv: Option<[u32; emit::NZCV_HELPERS]>,
     /// `Config::polled`: no `left`, [`emit::poll`] where a cycle can close.
     polled: bool,
+    /// CAPSTAT: each member's tally slots ([`capstat`]).
+    caps: Vec<Vec<u32>>,
+}
+
+/// CAPSTAT (measurement only): the tally slots a block's entry bumps: its length's, and for a block the cap ended,
+/// its straight-line length without the cap (and whether that run reaches the page's end).
+fn capstat(mem: &Mem, b: &Block) -> Vec<u32> {
+    let n = b.words.len();
+    let pa = b.key & !3;
+    let next = pa + 4 * n as u64;
+    let capped = n == CAP && next & 0xfff != 0 && end_op(decode(b.words[n - 1]), b.words[n - 1]) == End::No;
+    let at = tally::LEN_AT;
+    let mut v = vec![match n {
+        0..=4 => at,
+        5..=8 => at + 1,
+        9..=16 => at + 2,
+        17..=31 => at + 3,
+        _ if capped => at + 5,
+        _ => at + 4,
+    }];
+    if capped {
+        // The run on past the cap, to the first instruction that would end a block, or the page's end.
+        let (mut a, mut len, mut page) = (next, n, false);
+        loop {
+            let Ok(w) = mem.read(a, 4) else { break };
+            match end_op(decode(w as u32), w as u32) {
+                End::Before => break,
+                End::After => {
+                    len += 1;
+                    break;
+                }
+                End::No => len += 1,
+            }
+            a += 4;
+            if a & 0xfff == 0 {
+                page = true;
+                break;
+            }
+        }
+        let u = tally::UNCAP_AT;
+        v.push(match len {
+            0..=63 => u,
+            64..=127 => u + 1,
+            128..=255 => u + 2,
+            _ => u + 3,
+        });
+        if page {
+            v.push(u + 4);
+        }
+    }
+    v
 }
 
