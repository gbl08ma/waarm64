+    fn hosted(ram: &mut [u128]) -> (Cache, Table, Mem) {
+        // SAFETY: `ram` outlives the test's use of `mem` and is 16-byte aligned.
+        let mem = unsafe { Mem::new(ram.as_mut_ptr().cast(), ram.len() as u64 * 16) };
+        mem.write(0x1000, 4, 0x9100_0400).unwrap(); // add x0, x0, #1
+        mem.write(0x1004, 4, 0x1400_03ff).unwrap(); // b 0x2000
+        mem.write(0x2000, 4, 0xd65f_03c0).unwrap(); // ret
+        let mut c = Cache::new(Config::DEFAULT);
+        let mut t = Table::new(&mut c);
+        c.xmiss = Some(1);
+        (t.xmiss, t.base) = (true, 1);
