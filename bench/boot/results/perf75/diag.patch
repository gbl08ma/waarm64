+/// DIAG (PERF loop 75, queue row 12): each member's probes, counted at each run by `emit_region` into
+/// `tally::A + slot`: 0 the immediate forms' probes, 1 the accesses a group's probe covers, 2 the other loads and
+/// stores; the probes a probe earlier in the region already made (the same base register, unchanged or moved by an
+/// immediate, the range inside one it covered, the write array if it stores), along every edge into the member:
+/// 3-5 with today's entries (an entry knows nothing), SP / X29 / other bases; 6-8 if an entry's way in made its
+/// probes again; 9 all bases, if also SP and the callee-saved X19-X29 kept theirs across host calls (their
+/// continuation's edge); 10 those an earlier probe of the same member made (no group took them); 11 the member's
+/// runs; 12 the immediate probes of looped regions; 13 slots 3-5's of them; 14 slots 3-5's in members in another
+/// page than the head's.
+#[cfg(feature = "diag")]
+pub fn dom_counts(r: &Region, plans: &[Vec<emit::Role>]) -> Vec<[u64; 16]> {
+    let n = r.blocks.len();
+    let mut out = vec![[0u64; 16]; n];
+    if r.blocks[0].key & KEY_MMU == 0 {
+        return out;
+    }
+    // Edges into each member: (from, a host call's continuation).
+    let mut preds: Vec<Vec<(usize, bool)>> = vec![vec![]; n];
+    for i in 0..n {
+        let words = &r.blocks[i].words;
+        let op = words.last().map(|&w| decode(w));
+        let host = r.host_call(i) || op == Some(Op::BLR);
+        if !r.host_call(i) {
+            for o in offsets(words) {
+                if let Some(j) = r.target(i, o).filter(|&j| j > i) {
+                    preds[j].push((i, false));
+                }
+            }
+        }
+        if host && let Some(a) = call_after(words) && let Some(j) = r.target(i, a).filter(|&j| j > i) {
+            preds[j].push((i, true));
+        }
+        if let Some((j, _)) = r.returns_to(i) {
+            preds[j].push((i, false));
+        }
+    }
+    let ents = r.entries();
+    let saved = |x: &Fact| x.reg == 31 || (19..=29).contains(&x.reg);
+    for v in 0..3 {
+        let mut fout: Vec<Vec<Fact>> = vec![vec![]; n];
+        for j in 0..n {
+            let fin = if j == 0 || (v == 0 && ents.contains(&j)) || preds[j].is_empty() {
+                vec![]
+            } else {
+                let side = |&(i, cont): &(usize, bool)| -> Vec<Fact> {
+                    match (cont, v) {
+                        (false, _) => fout[i].clone(),
+                        (true, 2) => fout[i].iter().copied().filter(saved).collect(),
+                        (true, _) => vec![],
+                    }
+                };
+                let mut it = preds[j].iter();
+                let mut acc = side(it.next().unwrap());
+                for p in it {
+                    acc = meet(&acc, &side(p));
+                }
+                acc
+            };
+            fout[j] = dom_walk(&r.blocks[j].words, &plans[j], fin, v, &mut out[j]);
+        }
+    }
+    let looped = r.looped();
+    let head = &r.blocks[0];
+    for (j, c) in out.iter_mut().enumerate() {
+        let dom = c[3] + c[4] + c[5];
+        c[11] = 1;
+        if looped {
+            c[12] = c[0];
+            c[13] = dom;
+        }
+        if (r.blocks[j].key ^ head.key) >> 12 != 0 {
+            c[14] = dom;
+        }
+    }
+    out
+}
