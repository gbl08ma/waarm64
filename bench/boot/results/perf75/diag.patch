+/// DIAG (PERF loop 75, queue row 12): a range off a base register that a probe made (lo..hi from the register's
+/// value now), in the write array, and whether it came into the block from a predecessor.
+#[cfg(feature = "diag")]
+#[derive(Clone, Copy, PartialEq)]
+struct Fact {
+    reg: u32,
+    lo: i64,
+    hi: i64,
+    w: bool,
+    cross: bool,
+}
+
+#[cfg(feature = "diag")]
+fn kill(f: &mut Vec<Fact>, reg: u32) {
+    f.retain(|x| x.reg != reg);
+}
+
+/// The register moved by `d`: its facts' ranges move the other way (SP's go if its 16-byte alignment may not hold).
+#[cfg(feature = "diag")]
+fn shift(f: &mut Vec<Fact>, reg: u32, d: i64) {
+    if reg == 31 && d % 16 != 0 {
+        return kill(f, 31);
+    }
+    for x in f.iter_mut().filter(|x| x.reg == reg) {
+        (x.lo, x.hi) = (x.lo.wrapping_sub(d), x.hi.wrapping_sub(d));
+    }
+}
+
+/// `dst = src + d`.
+#[cfg(feature = "diag")]
+fn copy(f: &mut Vec<Fact>, dst: u32, src: u32, d: i64) {
+    kill(f, dst);
+    if dst == 31 {
+        return;
+    }
+    let add: Vec<Fact> = f
+        .iter()
+        .filter(|x| x.reg == src)
+        .map(|x| Fact {
+            reg: dst,
+            lo: x.lo.wrapping_sub(d),
+            hi: x.hi.wrapping_sub(d),
+            ..*x
+        })
+        .collect();
+    f.extend(add);
+}
+
+/// What holds on every path in: the ranges both sides proved, intersected.
+#[cfg(feature = "diag")]
+fn meet(a: &[Fact], b: &[Fact]) -> Vec<Fact> {
+    let mut out: Vec<Fact> = vec![];
+    for x in a {
+        for y in b.iter().filter(|y| y.reg == x.reg) {
+            let (lo, hi) = (x.lo.max(y.lo), x.hi.min(y.hi));
+            let f = Fact {
+                reg: x.reg,
+                lo,
+                hi,
+                w: x.w && y.w,
+                cross: true,
+            };
+            if lo < hi && !out.contains(&f) && out.len() < 64 {
+                out.push(f);
+            }
+        }
+    }
+    out
+}
+
+/// One member's instructions from facts `f` (counted into `n` by variant `v`: 0 today's entries, 1 entries that
+/// probe again, 2 that and SP and the callee-saved registers across host calls); the facts at its end.
+#[cfg(feature = "diag")]
+fn dom_walk(words: &[u32], plan: &[emit::Role], mut f: Vec<Fact>, v: usize, n: &mut [u64; 16]) -> Vec<Fact> {
+    use crate::interp::{bit, bits};
+    for x in f.iter_mut() {
+        x.cross = true;
+    }
+    for (k, &w) in words.iter().enumerate() {
+        if let Some((rn, off, len, write, wb, loads)) = emit::dshape(w) {
+            let probe = match plan.get(k) {
+                Some(&emit::Role::Lead { lo, span, store, .. }) => {
+                    Some((off + lo, off + lo + span as i64, store))
+                }
+                Some(emit::Role::Follow { .. }) => None,
+                _ => Some((off, off + len as i64, write)),
+            };
+            if let Some((lo, hi, wr)) = probe {
+                if v == 0 {
+                    n[0] += 1;
+                }
+                let dom = |x: &&Fact| x.reg == rn && x.lo <= lo && hi <= x.hi && (x.w || !wr);
+                let inblock = f.iter().filter(dom).any(|x| !x.cross);
+                let cross = f.iter().filter(dom).any(|x| x.cross);
+                if inblock {
+                    if v == 0 {
+                        n[10] += 1;
+                    }
+                } else if cross {
+                    let class = match rn {
+                        31 => 0,
+                        29 => 1,
+                        _ => 2,
+                    };
+                    match v {
+                        0 => n[3 + class] += 1,
+                        1 => n[6 + class] += 1,
+                        _ => n[9] += 1,
+                    }
+                } else {
+                    f.push(Fact {
+                        reg: rn,
+                        lo,
+                        hi,
+                        w: wr,
+                        cross: false,
+                    });
+                }
+            } else if v == 0 {
+                n[1] += 1;
+            }
+            for r in 0..31 {
+                if loads & 1 << r != 0 {
+                    kill(&mut f, r);
+                }
+            }
+            if loads & 1 << rn != 0 {
+                kill(&mut f, rn);
+            } else if wb != 0 {
+                shift(&mut f, rn, wb);
+            }
+            continue;
+        }
+        let op = decode(w);
+        let (rd, rn, rt2, rs) = (bits(w, 4, 0), bits(w, 9, 5), bits(w, 14, 10), bits(w, 20, 16));
+        let k_ = |f: &mut Vec<Fact>, r: u32| {
+            if r != 31 {
+                kill(f, r)
+            }
+        };
+        if (w >> 25) & 5 == 4 {
+            // Loads and stores no group takes (register offsets, exclusives, atomics, literals, structures...).
+            if v == 0 {
+                n[2] += 1;
+            }
+            let v_ = bit(w, 26);
+            if bits(w, 29, 27) == 0b111 {
+                let opc = bits(w, 23, 22);
+                let atomic = bit(w, 21) && bits(w, 11, 10) == 0 && !bit(w, 24);
+                if !v_ && (opc != 0 || atomic) {
+                    k_(&mut f, rd);
+                }
+                if !bit(w, 24) && bits(w, 11, 10) & 1 == 1 {
+                    kill(&mut f, rn); // pre/post-index, LDRAA/LDRAB
+                }
+            } else if bits(w, 29, 27) == 0b011 {
+                if !v_ {
+                    k_(&mut f, rd); // literal
+                }
+            } else if bits(w, 29, 27) == 0b101 {
+                if !v_ && bit(w, 22) {
+                    k_(&mut f, rd);
+                    k_(&mut f, rt2);
+                }
+                if bits(w, 24, 23) & 1 == 1 {
+                    kill(&mut f, rn);
+                }
+            } else {
+                // Exclusives, ordered, structures, the rest: anything they may name.
+                for r in [rd, rt2, rs, (rs + 1) & 31] {
+                    k_(&mut f, r);
+                }
+                kill(&mut f, rn);
+            }
+            continue;
+        }
+        use Op::*;
+        match op {
+            ADD_imm | SUB_imm if bit(w, 31) => {
+                let imm = (bits(w, 21, 10) as i64) << (12 * bits(w, 23, 22).min(1));
+                let d = if op == ADD_imm { imm } else { -imm };
+                if rd == rn {
+                    shift(&mut f, rd, d);
+                } else {
+                    copy(&mut f, rd, rn, d);
+                }
+            }
+            ORR_shift if bit(w, 31) && rn == 31 && bits(w, 15, 10) == 0 && rd != 31 => {
+                let rm = bits(w, 20, 16);
+                if rm == 31 {
+                    kill(&mut f, rd);
+                } else {
+                    copy(&mut f, rd, rm, 0);
+                }
+            }
+            ADD_imm | SUB_imm | ADD_ext | SUB_ext | AND_imm | ORR_imm | EOR_imm => kill(&mut f, rd),
+            BL | BLR | BLRA => kill(&mut f, 30),
+            CCMP_imm | CCMP_reg | CCMN_imm | CCMN_reg | RMIF | SETF8 | SETF16 | CFINV => {}
+            MRS | SYSL => k_(&mut f, rd),
+            _ if bits(w, 28, 26) == 0b101 => {} // branches, the rest of the system space
+            _ if bits(w, 28, 25) & 7 == 7 => {
+                // SIMD&FP: only the conversions to general registers and SMOV/UMOV write one.
+                let conv = bits(w, 28, 24) == 0b11110 && bit(w, 21) && bits(w, 15, 10) == 0;
+                let mov = !bit(w, 31) && bits(w, 28, 21) == 0b0111_0000 && !bit(w, 15) && bit(w, 10);
+                if conv || mov {
+                    k_(&mut f, rd);
+                }
+            }
+            _ => k_(&mut f, rd),
+        }
+    }
+    f
+}
