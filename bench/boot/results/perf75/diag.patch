+/// DIAG (PERF loop 27's, on today's tree): the locals X registers would take if each dropped its local after its
+/// last touch.
+#[cfg(feature = "diag")]
+fn diag_colors(trace: &[(u32, bool)], barriers: bool, plain: u64) -> u32 {
+    let n = trace.len();
+    let mut last = [None; 32];
+    for (k, &(t, _)) in trace.iter().enumerate() {
+        for (r, l) in last.iter_mut().enumerate() {
+            if t & 1 << r != 0 {
+                *l = Some(k);
+            }
+        }
+    }
+    let mut held = vec![0u32; n];
+    let mut cur = 0u32;
+    for (k, &(t, h)) in trace.iter().enumerate() {
+        if h && barriers {
+            cur = 0;
+        }
+        cur |= t & !(plain as u32);
+        held[k] = cur;
+        for (r, l) in last.iter().enumerate() {
+            if *l == Some(k) {
+                cur &= !(1 << r);
+            }
+        }
+    }
+    let mut conf = [0u32; 32];
+    for &m in &held {
+        let mut x = m;
+        while x != 0 {
+            let r = x.trailing_zeros();
+            x &= x - 1;
+            conf[r as usize] |= m;
+        }
+    }
+    let mut order: Vec<usize> = (0..32).filter(|&r| last[r].is_some() && plain & 1 << r == 0).collect();
+    order.sort_by_key(|&r| trace.iter().position(|&(t, _)| t & 1 << r != 0));
+    let mut color = [u32::MAX; 32];
+    let mut ncol = 0;
+    for &r in &order {
+        let mut used = 0u64;
+        for q in 0..32 {
+            if q != r && conf[r] & 1 << q != 0 && color[q] != u32::MAX {
+                used |= 1 << color[q];
+            }
+        }
+        color[r] = (!used).trailing_zeros();
+        ncol = ncol.max(color[r] + 1);
+    }
+    ncol
+}
