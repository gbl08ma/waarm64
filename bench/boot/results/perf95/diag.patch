 //! IRQ), and round-robin's timer reprogramming ([`TIMER_SET`]).
 
 /// Words in each table.
-pub const N: usize = 80;
+pub const N: usize = 184;
+/// PERF loop 95 (temporary): compiled code's block ends at a system instruction, `P95 + 2 * class + edge`
+/// ([`p95_class`]; `edge`: the block's successor is a member of its region), published like the JIT's, to [`P95_END`].
+pub const P95: usize = 80;
+pub const P95_END: usize = 180;
+
+/// PERF loop 95: the class of a block-ending system instruction `w` (of class `op`), 0 for none of those listed.
+#[cfg(feature = "diag")]
+pub fn p95_class(w: u32, op: crate::decode::Op) -> u32 {
+    use crate::decode::Op::*;
+    let b = |hi: u32, lo: u32| (w >> lo) & ((1 << (hi - lo + 1)) - 1);
+    let sr = |op0: u32, op1: u32, crn: u32, crm: u32, op2: u32| {
+        op0 << 14 | op1 << 11 | crn << 7 | crm << 3 | op2
+    };
+    match op {
+        MSR_reg => {
+            let k = b(20, 5);
+            match k {
+                _ if k == sr(3, 0, 2, 0, 0) => 1,
+                _ if k == sr(3, 0, 2, 0, 1) => 2,
+                _ if k == sr(3, 0, 2, 0, 2) => 3,
+                _ if k == sr(3, 0, 1, 0, 0) => 4,
+                _ if k == sr(3, 0, 13, 0, 1) => 5,
+                _ if k == sr(3, 0, 12, 0, 0) => 6,
+                _ if k == sr(3, 0, 1, 0, 2) => 7,
+                _ if k == sr(2, 0, 0, 2, 2) => 8,
+                _ if k == sr(3, 3, 4, 4, 0) => 9,
+                _ if k == sr(3, 3, 4, 4, 1) => 10,
+                _ if k == sr(3, 3, 4, 2, 0) => 11,
+                _ if k == sr(3, 0, 14, 1, 0) => 12,
+                _ if k == sr(3, 0, 12, 12, 1) => 13,
+                _ if k == sr(3, 0, 12, 11, 5) => 14,
+                _ if k == sr(3, 0, 4, 6, 0) => 15,
+                _ if k == sr(3, 0, 12, 11, 1) => 16,
+                _ if k >> 7 == sr(3, 0, 12, 0, 0) >> 7 && b(11, 8) >= 8 => 17,
+                _ => 18,
+            }
+        }
+        MSR_imm => match (b(18, 16), b(7, 5)) {
+            (0, 4) => 19,
+            (0, 5) => 20,
+            _ => 21,
+        },
+        SYS | SYSL if op == SYS && b(15, 12) == 8 => match (b(18, 16), b(11, 8), b(7, 5)) {
+            (0, 3, 0) => 22,
+            (0, 7, 0) => 23,
+            (0, 3, 1) => 24,
+            (0, 3, 5) => 25,
+            (0, 3, 2) => 26,
+            (0, 3, 3) => 27,
+            (0, 3, 7) => 28,
+            (0, 7, _) => 29,
+            (0, 2 | 6 | 5 | 1, _) => 30,
+            _ => 31,
+        },
+        SYS if b(15, 12) == 7 && b(11, 8) & 0b1110 == 8 => 32,
+        SYS | SYSL => 33,
+        DC_IVAC => 34,
+        DC_ISW | DC_CSW | DC_CISW => 35,
+        DC_CVAC => 36,
+        DC_CVAU => 37,
+        DC_CIVAC => 38,
+        IC_IALLU => 39,
+        IC_IALLUIS => 40,
+        IC_IVAU => 41,
+        ISB => 42,
+        CLREX => 43,
+        YIELD => 44,
+        SEV => 45,
+        SEVL => 46,
+        WFE => 47,
+        WFI => 48,
+        ERET => 49,
+        _ => 0,
+    }
+}
 
 /// A region's loop back-edge taken (a `br` to the head's `loop`).
