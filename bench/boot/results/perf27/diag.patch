+static DIAG: [AtomicU64; 3] = [AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0)];
+static DIAG_REP: [AtomicU64; 3] = [AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0)];
+static DIAG_PRO: [AtomicU64; 2] = [AtomicU64::new(0), AtomicU64::new(0)];
