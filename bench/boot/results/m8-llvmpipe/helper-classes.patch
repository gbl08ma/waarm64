+/// Diagnostic: the FP classes in Vn's and Vm's lanes (as singles, or doubles with bit 22),
+/// bits 0-4 Vn's (zero, denormal, normal, inf, NaN), 5-9 Vm's; 0x400 if not vector.
+fn classes(c: &crate::cpu::Cpu, i: u32) -> u32 {
+    if i & 0x9f000000 != 0x0e000000 && i & 0x9f000000 != 0x0f000000 {
+        return 0x400;
+    }
+    let d = i >> 22 & 1 == 1;
+    let one = |x: u128| {
+        let mut m = 0;
+        let (n, w, eb, fb) = if d { (2, 64, 11, 52) } else { (4, 32, 8, 23) };
+        for e in 0..n {
+            let v = (x >> (e * w)) as u64 & (u64::MAX >> (64 - w));
+            let (ex, fr) = (v >> fb & ((1 << eb) - 1), v & ((1 << fb) - 1));
+            m |= if ex == 0 && fr == 0 { 1 } else if ex == 0 { 2 } else if ex == (1 << eb) - 1 { if fr == 0 { 8 } else { 16 } } else { 4 };
+        }
+        m
+    };
+    one(c.v[(i >> 5 & 31) as usize]) | one(c.v[(i >> 16 & 31) as usize]) << 5
+}
