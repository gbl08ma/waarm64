+// Relinking (docs/jit.md "Relinking"): a block compiled before its static successor reaches it through
+// the jump cache (a `return_call_indirect`); once those hits pass `relink`, its region is compiled again
+// with the successor as a direct link. A loop calls H through `blr x9`; H branches to B, which returns:
+//   0x1000 L: blr x9; subs x5, x5, #1; b.ne L; brk
+//   0x1100 H: add x1, x1, #1; b B
+//   0x1180 B: add x2, x2, #1; ret
+// With a threshold of 2 and a batch of 1, H is compiled on its second dispatch, B (not in H's batch)
+// on its own, so H's edge to B is a jump-cache tail until H is compiled again.
+function relinked(threshold: number, relink: number) {
+  const { ex, memory } = core(true);
+  const e = ex as unknown as Exports & Record<string, (...a: (number | bigint)[]) => number | bigint>;
+  const base = memory.grow(1) * 65536;
+  new Uint32Array(memory.buffer, base + 0x1000, 4).set([0xd63f0120, 0xf10004a5, 0x54ffffc1, 0xd4200000]);
+  new Uint32Array(memory.buffer, base + 0x1100, 2).set([0x91000421, 0x1400001f]);
+  new Uint32Array(memory.buffer, base + 0x1180, 2).set([0x91000442, 0xd65f03c0]);
+  const v = e.jit_new(threshold, 1, 64, 0, 1000, relink) as number;
+  const x = new BigUint64Array(memory.buffer, v, 33);
+  [x[5], x[9], x[32]] = [1000n, 0x1100n, 0x1000n];
+  const exit = e.vcpu_new() as number;
+  const done = e.jit_run_exit(v, e.mem_new(base, 65536n), 100_000_000n, exit) as bigint;
+  assert.equal(new BigUint64Array(memory.buffer, exit, 1)[0], 6n); // brk
+  const st = new BigUint64Array(memory.buffer, e.jit_stats(v) as number, 41);
+  return { done, x1: x[1], x2: x[2], x5: x[5], relinks: st[40] };
+}
+
+test('a region linked through the jump cache is compiled again once its successor is compiled, linked to it', () => {
+  const want = { done: 7000n, x1: 1000n, x2: 1000n, x5: 0n };
+  const { relinks: none, ...interpreted } = relinked(0xffff_ffff, 4);
+  assert.deepEqual([interpreted, none], [want, 0n]);
+  const { relinks: off, ...plain } = relinked(2, 0);
+  assert.deepEqual([plain, off], [want, 0n]);
+  const { relinks, ...jit } = relinked(2, 4);
+  assert.deepEqual([jit, relinks], [want, 1n], 'H, once');
+});
