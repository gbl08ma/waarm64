+/// A jump-cache tail or by-VA link taken, in a region that counts them
+/// ([`Func::relink`]; docs/jit.md "Relinking"): its hot word counts the hits
+/// down, and the hit that takes it from 1 to 0 calls `jit_relink(vcpu, key)`,
+/// which queues the region to be compiled again, linked to the successors
+/// compiled since. 0 stays 0. Inside the tail's taken arm, where the i32
+/// scratch locals 8 and 9 are free.
+fn relink_count(c: &mut Func) {
+    const H: u32 = 8;
+    const V: u32 = 9;
+    let Some((word, key, relink)) = c.relink.take() else {
