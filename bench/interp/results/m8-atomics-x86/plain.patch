+            1 => (p as *const u8).read_volatile() as u64,
+            2 => u16::from_le((p as *const u16).read_volatile()) as u64,
+            4 => u32::from_le((p as *const u32).read_volatile()) as u64,
+            _ => u64::from_le((p as *const u64).read_volatile()),
         }
     })
 }
@@ -656,10 +656,10 @@ pub(crate) unsafe fn store_aligned(p: *mut u8, size: u32, val: u64) -> bool {
