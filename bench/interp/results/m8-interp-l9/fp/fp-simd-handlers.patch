+/// FPCR's rounding mode and flush-to-zero bits, and FPSR's cumulative Inexact.
+const RMODE: u64 = 3 << 22;
+const FZ: u64 = 1 << 24;
+const IXC: u64 = 1 << 4;
+
+/// FP and AdvSIMD enabled at the current EL (`CPACR_EL1.FPEN`), as
+/// `interp::fp_enabled`.
+#[inline(always)]
+fn fp_on(c: &Cpu) -> bool {
+    let en = c.cpacr_el1 >> 20 & 3;
+    en == 3 || en == 1 && c.el() == 1
+}
