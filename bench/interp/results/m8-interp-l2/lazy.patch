+/// [`hot`]'s lazy NZCV: SUBS (x - y) and ADDS of 64 and 32 bits, and the
+/// logical ones' result (C and V clear).
+const SUB64: u32 = 1;
+const SUB32: u32 = 2;
+const ADD64: u32 = 3;
+const ADD32: u32 = 4;
+const LOG64: u32 = 5;
+const LOG32: u32 = 6;
+
+#[inline(always)]
+fn lazy(sub: bool, sf: bool) -> u32 {
+    match (sub, sf) {
+        (true, true) => SUB64,
+        (true, false) => SUB32,
+        (false, true) => ADD64,
+        (false, false) => ADD32,
+    }
+}
+
+/// The NZCV of a lazy kind and its operands.
+#[inline(always)]
+fn flags(k: u32, a: u64, b: u64) -> u64 {
+    match k {
+        SUB64 => add_with_carry(a, !b, true, true).1,
+        SUB32 => add_with_carry(a, !b, true, false).1,
+        ADD64 => add_with_carry(a, b, false, true).1,
+        ADD32 => add_with_carry(a, b, false, false).1,
+        LOG64 => super::nzcv(a >> 63 == 1, a == 0, false, false),
+        _ => super::nzcv(a >> 31 & 1 == 1, a as u32 == 0, false, false),
+    }
+}
+
+/// Whether condition `cond` holds for the lazy flags (`nzcv` when `k` is 0);
+/// after a SUBS, from its operands, as `emit.rs` does.
+#[inline(always)]
+fn holds(k: u32, a: u64, b: u64, nzcv: u64, cond: u32) -> bool {
+    if k != SUB64 && k != SUB32 {
+        return cond_holds(if k == 0 { nzcv } else { flags(k, a, b) }, cond);
+    }
+    let (eq, ltu, lts, neg) = if k == SUB64 {
+        (a == b, a < b, (a as i64) < (b as i64), (a.wrapping_sub(b) as i64) < 0)
+    } else {
+        let (a, b) = (a as u32, b as u32);
+        (a == b, a < b, (a as i32) < (b as i32), (a.wrapping_sub(b) as i32) < 0)
+    };
+    let r = match cond >> 1 & 7 {
+        0 => eq,
+        1 => !ltu,
+        2 => neg,
+        // V: N differs from the signed comparison.
+        3 => neg != lts,
+        4 => !ltu && !eq,
+        5 => !lts,
+        6 => !lts && !eq,
+        _ => true,
+    };
+    if cond & 1 != 0 && cond != 15 { !r } else { r }
+}
