+/// The dispatches block `i` counts before it joins the batch, at compile
+/// threshold `t` (docs/jit.md "Compile policy").
+fn need(cfg: &Config, t: u32, i: &Info) -> u32 {
+    let (mut t, len) = (t as u64, i.len.max(1) as u64);
+    if cfg.steps != 0 {
+        t = t * cfg.steps as u64 / len;
+    }
+    if cfg.gain != 0 {
+        t = t * len / (len + cfg.gain as u64 * i.slow as u64);
+    }
+    t.min(u32::MAX as u64) as u32
+}
