+/// What the JIT's compile policy knows of a block ([`crate::jit`]'s
+/// `need`): its length, and the instructions of it that are slow here and
+/// fast compiled ([`slow`]).
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Shape {
+    pub len: u32,
+    pub slow: u32,
+}
+
+/// Whether word `w`, run as micro-op kind `k`, is slow here and fast
+/// compiled: a SIMD&FP instruction on the generic path (~17 ns a step
+/// against ~0.7 compiled; an integer micro-op saves 1-2.5 ns). The other
+/// generic forms (the regime's MSRs, ERET, ISB) are helper calls compiled
+/// too: nothing to gain.
+fn slow(w: u32, k: K) -> bool {
+    k == K::Generic && (w >> 25 & 7 == 7 || w >> 25 & 7 == 6)
+}
+
+/// The shape of the block at `key` (a JIT block key), decoded from `mem`.
+pub fn shape(mem: &Mem, key: u64) -> Shape {
+    let u = crate::jit::block::form_with(mem, key & !3, |w, op| {
+        slow(w, uop_el(w, op, key & 1 != 0).k)
+    });
+    Shape {
+        len: u.len() as u32,
+        slow: u.iter().filter(|&&g| g).count() as u32,
+    }
+}
