--- a/core/src/mem.rs
+++ b/core/src/mem.rs
@@ -754,6 +754,36 @@ pub(crate) unsafe fn store_aligned(p: *mut u8, size: u32, val: u64) -> bool {
     true
 }
 
+/// [`store`] of a misaligned access, as [`store_split`] in naturally aligned
+/// pieces (1, 2 or 4 bytes: a misaligned access has no aligned 8) but inline
+/// and with no call, for the block interpreter's inline paths. Each byte is
+/// written once, by an atomic store, and no byte outside the access is
+/// touched (another vCPU may own it), which is all a misaligned access is owed
+/// without LSE2.
+///
+/// # Safety
+/// `p..p + size` is guest RAM, and `p` isn't aligned to `size`.
+#[inline(always)]
+pub(crate) unsafe fn store_misaligned(p: *mut u8, size: u32, val: u64) {
+    const O: Ordering = Ordering::Relaxed;
+    let (mut k, mut v) = (0, val);
+    while k < size {
+        let q = p.wrapping_add(k as usize);
+        // `piece`, written out: inline for certain.
+        let n = 1 << (q as usize as u32).trailing_zeros().min(31 - (size - k).leading_zeros());
+        // SAFETY: `q..q + n` is within the access and aligned to `n`.
+        unsafe {
+            match n {
+                1 => AtomicU8::from_ptr(q).store(v as u8, O),
+                2 => AtomicU16::from_ptr(q as *mut u16).store((v as u16).to_le(), O),
+                _ => AtomicU32::from_ptr(q as *mut u32).store((v as u32).to_le(), O),
+            }
+        }
+        v >>= 8 * n;
+        k += n;
+    }
+}
