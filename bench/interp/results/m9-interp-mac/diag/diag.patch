@@ -0,0 +1,147 @@
+//! DIAGNOSTIC (interpreter speed on the Mac; not for commit): why `hot` returns and what its
+//! callers do then, per table. Dumped as `webpc-slow diag2` lines every 20 s.
+
+pub struct Diag {
+    pub c: [u64; N],
+    last: f64,
+}
+
+pub const NAMES: [&str; N] = [
+    "interp_calls",
+    "interp_none",
+    "hot_calls",
+    "st_stop_rest",
+    "st_stop_compiled",
+    "st_stop_quota",
+    "st_slow",
+    "st_next_ikey",
+    "st_next_slot",
+    "chained",
+    "slow_uops",
+    "slow_exit",
+    "slow_nochain",
+    "nx_key_none",
+    "nx_compiled",
+    "nx_count_false",
+    "nx_get_none",
+    "nx_entered",
+    "count_out",
+    "count_out_true",
+    "miss_map",
+    "miss_len0",
+    "miss_decode",
+    "enter_counted",
+    "enter_miss",
+    "jmiss_empty",
+    "jmiss_known",
+    "jmiss_skipped",
+    "jmiss_locked",
+    "slow_ld",
+    "slow_generic",
+    "nx_samepage",
+    "chained_samepage",
+    "stop_quota_samepage",
+    "jmiss_ok",
+];
+pub const N: usize = 35;
+
+pub const INTERP_CALLS: usize = 0;
+pub const INTERP_NONE: usize = 1;
+pub const HOT_CALLS: usize = 2;
+pub const ST_STOP_REST: usize = 3;
+pub const ST_STOP_COMPILED: usize = 4;
+pub const ST_STOP_QUOTA: usize = 5;
+pub const ST_SLOW: usize = 6;
+pub const ST_NEXT_IKEY: usize = 7;
+pub const ST_NEXT_SLOT: usize = 8;
+pub const CHAINED: usize = 9;
+pub const SLOW_UOPS: usize = 10;
+pub const SLOW_EXIT: usize = 11;
+pub const SLOW_NOCHAIN: usize = 12;
+pub const NX_KEY_NONE: usize = 13;
+pub const NX_COMPILED: usize = 14;
+pub const NX_COUNT_FALSE: usize = 15;
+pub const NX_GET_NONE: usize = 16;
+pub const NX_ENTERED: usize = 17;
+pub const COUNT_OUT: usize = 18;
+pub const COUNT_OUT_TRUE: usize = 19;
+pub const MISS_MAP: usize = 20;
+pub const MISS_LEN0: usize = 21;
+pub const MISS_DECODE: usize = 22;
+pub const ENTER_COUNTED: usize = 23;
+pub const ENTER_MISS: usize = 24;
+pub const JMISS_EMPTY: usize = 25;
+pub const JMISS_KNOWN: usize = 26;
+pub const JMISS_SKIPPED: usize = 27;
+pub const JMISS_LOCKED: usize = 28;
+pub const SLOW_LD: usize = 29;
+pub const SLOW_GENERIC: usize = 30;
+pub const NX_SAMEPAGE: usize = 31;
+pub const CHAINED_SAMEPAGE: usize = 32;
+pub const STOP_QUOTA_SAMEPAGE: usize = 33;
+pub const JMISS_OK: usize = 34;
+
+fn now() -> f64 {
+    #[cfg(target_arch = "wasm32")]
+    // SAFETY: a host function with no preconditions.
+    return unsafe { crate::vm::now_ms() };
+    #[cfg(not(target_arch = "wasm32"))]
+    0.0
+}
+
+#[cfg(target_arch = "wasm32")]
+#[link(wasm_import_module = "env")]
+unsafe extern "C" {
+    fn diag_log(ptr: *const u8, len: usize);
+}
+
+impl Default for Diag {
+    fn default() -> Diag {
+        Diag { c: [0; N], last: 0.0 }
+    }
+}
+
+impl Diag {
+    #[inline(always)]
+    pub fn inc(&mut self, i: usize) {
+        self.c[i] += 1;
+    }
+
+    #[inline(always)]
+    pub fn add(&mut self, i: usize, n: u64) {
+        self.c[i] += n;
+    }
+
+    pub fn tick(&mut self, id: usize, dec_steps: u64) {
+        let t = now();
+        if t - self.last < 20_000.0 {
+            return;
+        }
+        self.last = t;
+        let mut s = format!("webpc-slow diag2 {id:x} t {t:.0} dec_steps {dec_steps}");
+        for (n, v) in NAMES.iter().zip(self.c.iter()) {
+            s += &format!(" {n} {v}");
+        }
+        for (n, v) in GNAMES.iter().zip(G.iter()) {
+            s += &format!(" g_{n} {}", v.load(core::sync::atomic::Ordering::Relaxed));
+        }
+        #[cfg(target_arch = "wasm32")]
+        // SAFETY: the host reads `len` bytes at `ptr`.
+        unsafe {
+            diag_log(s.as_ptr(), s.len())
+        };
+        #[cfg(not(target_arch = "wasm32"))]
+        let _ = s;
+    }
+}
+
+/// Global diagnostic counters (relaxed atomics): the load/store fast paths' misses.
+pub static G: [core::sync::atomic::AtomicU64; GN] = [const { core::sync::atomic::AtomicU64::new(0) }; GN];
+pub const GN: usize = 12;
+pub const GNAMES: [&str; GN] = [
+    "o_tlb", "o_align", "s_tlb", "s_align", "s_sp", "p_tlb", "p_align", "p_sp", "o_sp", "fp_any", "other_ld", "o_cross",
+];
+#[inline(always)]
+pub fn g(i: usize) {
+    G[i].fetch_add(1, core::sync::atomic::Ordering::Relaxed);
+}
