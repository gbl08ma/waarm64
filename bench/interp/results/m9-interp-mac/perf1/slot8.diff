+/// A slot: a decoded block's key, where its micro-ops are and the dispatches
+/// it may count before it reports, in 8 bytes (16 until 2026-11-10: the key
+/// whole). It keeps only the key's bits that its index doesn't imply, in
+/// place, so a lookup is one compare under [`TAG`]:
+///
+/// - bits 0-1: the key's regime bits;
+/// - bits 2-9: the dispatches it may count before it reports ([`Cache::quota`]
+///   less what it counted: the map's `quota` keeps what it was given);
+/// - bit 10: it counted since it was slotted (the map's `hits` is stale);
+/// - bits 11-16: its length in micro-ops;
+/// - bits `SLOTS_LOG2 + 2`-39: the key's bits above its index (a key of a
+///   block is a PA and its regime bits, under [`PA_BITS`]);
+/// - bit 40: filled (all zeros is an empty slot, so the table is allocated
+///   zeroed and its untouched pages take no memory);
+/// - bits 41-63: where its micro-ops start in the arena (under [`MAX_BUDGET`]).
+type Slot = u64;
+
+const SLOTS_LOG2: u32 = 18;
+const S_LEFT: u32 = 2;
+const S_LEFT1: u64 = 1 << S_LEFT;
+const S_LEFTS: u64 = 0xff << S_LEFT;
+const S_DIRTY: u64 = 1 << 10;
+const S_LEN: u32 = 11;
+const S_FULL: u64 = 1 << PA_BITS;
+const S_START: u32 = PA_BITS + 1;
+/// The key's bits a slot keeps in place (without [`S_FULL`]).
+const S_KEY: u64 = 3 | ((1 << PA_BITS) - 1) & !((1 << (SLOTS_LOG2 + 2)) - 1);
+/// The bits a lookup compares: a slot holds key `k` when `(s ^ k) & TAG == S_FULL`.
+const TAG: u64 = S_KEY | S_FULL;
+const _: () = assert!(SLOTS_LOG2 + 2 >= S_LEN + 6 && MAX_BUDGET <= 1 << (64 - S_START));
