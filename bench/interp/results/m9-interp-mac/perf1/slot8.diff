+/// Whether slot `s` holds key `k` (one under [`PA_BITS`]: no block's key is
+/// above it, and a key above it would alias one under it).
+#[inline(always)]
+fn slot_holds(s: Slot, k: u64) -> bool {
+    (s ^ k) & TAG == S_FULL && k >> PA_BITS == 0
