+/// A slot keeps only the key bits its index doesn't imply (and the PA's): a
+/// key above `PA_BITS` (a PC there with the MMU off: no RAM) never matches the
+/// block whose bits it has under them.
+#[test]
+fn a_key_above_the_pa_bits_is_never_slotted() {
+    let t = TestRam::new(RAM);
+    t.mem.write(CODE, 4, 0x9100_0400).unwrap(); // add x0, x0, #1
+    t.mem.write(CODE + 4, 4, 0xd65f_03c0).unwrap(); // ret
+    let mut c = Cache::new(MAX_BUDGET);
+    c.decode(CODE, &t.mem);
+    c.quota(CODE, REPORT);
+    assert!(c.slotted(CODE) && c.count(CODE));
+    for hi in [1u64 << crate::mmu::PA_BITS, 1 << 63] {
+        assert!(!c.slotted(CODE | hi) && !c.count(CODE | hi));
+        assert!(c.get(CODE | hi, &t.mem).is_none());
+    }
+    // Nor another regime's, nor another key of its slot.
+    for k in [CODE | 1, CODE | 2, CODE + 4 * SLOTS as u64] {
+        assert!(!c.slotted(k));
+    }
+    assert_eq!(c.counted(CODE), 1);
+}
+
 /// A key with no instructions is remembered (the JIT asks its cache about it
 /// once), until an IC names its page.
 #[test]
