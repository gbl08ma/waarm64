diff --git a/core/src/interp/block.rs b/core/src/interp/block.rs
index a243dc67..29dfec90 100644
--- a/core/src/interp/block.rs
+++ b/core/src/interp/block.rs
@@ -2918,3 +2918,149 @@ impl Cache {
 
 #[cfg(test)]
 mod tests;
+
+/// DIAGNOSTIC (PERF loop 17; not for commit): what `hot`'s slow exits run, by class.
+pub mod diag {
+    use super::{K, Uop};
+    use crate::decode::Op;
+    use core::sync::atomic::{AtomicU64, Ordering::Relaxed};
+    const NOPS: usize = Op::ALL.len();
+    const N: usize = NOPS + 64 + 32;
+    const X: usize = NOPS + 64;
+    /// Exits from `hot` by the first micro-op's class; micro-ops run in stretches by class.
+    static EXITS: [AtomicU64; N] = [const { AtomicU64::new(0) }; N];
+    static UOPS: [AtomicU64; N] = [const { AtomicU64::new(0) }; N];
+    static TOT: [AtomicU64; 4] = [const { AtomicU64::new(0) }; 4];
+    static LAST: AtomicU64 = AtomicU64::new(0);
+
+    fn class(u: &Uop) -> usize {
+        if u.kind() == K::Generic {
+            (u.d as u16 | (u.n as u16) << 8) as usize
+        } else {
+            NOPS + u.k as usize
+        }
+    }
+
+    fn name(i: usize) -> String {
+        if (X..X + 20).contains(&(i)) {
+            let k = ["Ld", "St", "LdO", "StO", "Fp"][(i - X) / 4];
+            return format!("{k}_{}", ["mis", "cross", "other", "fpen"][(i - X) % 4]);
+        }
+        if i == N - 1 {
+            return "pair_misaligned".into();
+        }
+        if i == N - 2 {
+            return "pair_crosspage".into();
+        }
+        if i < NOPS {
+            format!("{:?}", Op::ALL[i])
+        } else {
+            // SAFETY: a K's discriminant.
+            format!("K_{:?}", unsafe { core::mem::transmute::<u8, K>((i - NOPS) as u8) })
+        }
+    }
+
+    /// One exit: the stretch's `n` micro-ops from `b[0]`.
+    pub fn exit(c: &crate::cpu::Cpu, b: &[Uop], n: usize, steps: u64) {
+        let mut k0 = class(&b[0]);
+        let u = &b[0];
+        if matches!(u.kind(), K::Ldp | K::Stp) {
+            let base = c.x[u.n as usize];
+            let (size, mode) = (u.w & 15, u.w >> 8 & 3);
+            let imm = (u.w as i32 >> 16) as i64 as u64;
+            let addr = if mode == 1 { base } else { base.wrapping_add(imm) };
+            if addr & (size as u64 - 1) != 0 {
+                k0 = N - 1;
+            } else if (addr & 0xfff) + 2 * size as u64 > 0x1000 {
+                k0 = N - 2;
+            }
+        }
+        let kinds = [K::Ld, K::St, K::LdO, K::StO, K::Fp];
+        if let Some(j) = kinds.iter().position(|&k| k == u.kind()) {
+            let base = c.x[u.n as usize];
+            let w = u.w;
+            let (addr, bytes, align, fpen) = match u.kind() {
+                K::LdO | K::StO => (base.wrapping_add((w as i32 >> 16) as i64 as u64), 4u64 << (w & 1), 4u64 << (w & 1), true),
+                K::Ld | K::St => {
+                    let imm = (w as i32 >> 16) as i64 as u64;
+                    let a = match w >> 2 & 3 {
+                        0 | 1 => base.wrapping_add(imm),
+                        2 => base,
+                        _ => base.wrapping_add(super::extend(c.reg(u.m as u32), w >> 8 & 7, w >> 12 & 7)),
+                    };
+                    (a, 1u64 << (w & 3), 1u64 << (w & 3), true)
+                }
+                _ => {
+                    // SAFETY: an Fp's `w` is its constant's distance.
+                    let kv = unsafe { super::konst(u) };
+                    let x = (kv >> 32) as u32 & 0xff;
+                    let (log, mode) = (x & 7, x >> 3 & 3);
+                    let off = ((kv as i64) >> 40) as u64;
+                    let a = if mode == 2 { base } else { base.wrapping_add(off) };
+                    let bytes = 1u64 << log;
+                    let span = if x >> 6 & 1 != 0 { 2 * bytes } else { bytes };
+                    let en = c.cpacr_el1 >> 20 & 3;
+                    (a, span, bytes.min(8), en == 3 || en == 1 && c.el() == 1)
+                }
+            };
+            let cause = if !fpen {
+                3
+            } else if addr & (align - 1) != 0 {
+                0
+            } else if (addr & 0xfff) + bytes > 0x1000 {
+                1
+            } else {
+                2
+            };
+            k0 = X + 4 * j + cause;
+        }
+        EXITS[k0].fetch_add(1, Relaxed);
+        for u in &b[..n] {
+            UOPS[class(u)].fetch_add(1, Relaxed);
+        }
+        TOT[0].fetch_add(1, Relaxed);
+        TOT[1].fetch_add(n as u64, Relaxed);
+        let _ = steps;
+    }
+
+    /// Steps interpreted (to put the counts against).
+    pub fn steps(n: u64) {
+        TOT[2].fetch_add(n, Relaxed);
+        TOT[3].fetch_add(1, Relaxed);
+        #[cfg(target_arch = "wasm32")]
+        {
+            // SAFETY: a host function with no preconditions.
+            let t = unsafe { crate::vm::now_ms() } as u64;
+            let l = LAST.load(Relaxed);
+            if t >= l + 20_000 && LAST.compare_exchange(l, t, Relaxed, Relaxed).is_ok() {
+                let s = report();
+                // SAFETY: the host reads `len` bytes at `ptr`.
+                unsafe { diag_log(s.as_ptr(), s.len()) };
+            }
+        }
+    }
+
+    #[cfg(target_arch = "wasm32")]
+    #[link(wasm_import_module = "env")]
+    unsafe extern "C" {
+        fn diag_log(ptr: *const u8, len: usize);
+    }
+
+    /// One line: totals, then every class with exits or micro-ops.
+    pub fn report() -> String {
+        let mut s = format!(
+            "webpc-slow diag17 exits {} uops {} steps {} interps {}",
+            TOT[0].load(Relaxed),
+            TOT[1].load(Relaxed),
+            TOT[2].load(Relaxed),
+            TOT[3].load(Relaxed)
+        );
+        for i in 0..N {
+            let (e, u) = (EXITS[i].load(Relaxed), UOPS[i].load(Relaxed));
+            if e | u != 0 {
+                s += &format!(" {}:{e}:{u}", name(i));
+            }
+        }
+        s
+    }
+}
