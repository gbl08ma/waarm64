+/// [`add_with_carry`] in [`hot`], where the carry in is `sub` and `y` is the
+/// second operand already inverted for a subtraction: C from the operands, as
+/// the JIT's (`x >= !y` for a subtraction, `r < x` for an addition), one add
+/// and one compare instead of two of each.
+#[inline(always)]
+fn addc(x: u64, y: u64, sub: bool, sf: bool) -> (u64, u64) {
+    if sf {
+        let r = x.wrapping_add(y).wrapping_add(sub as u64);
+        let c = if sub { x >= !y } else { r < x };
+        let v = ((x ^ r) & (y ^ r)) >> 63 == 1;
+        (r, super::nzcv(r >> 63 == 1, r == 0, c, v))
+    } else {
+        let (x, y) = (x as u32, y as u32);
+        let r = x.wrapping_add(y).wrapping_add(sub as u32);
+        let c = if sub { x >= !y } else { r < x };
+        let v = ((x ^ r) & (y ^ r)) >> 31 == 1;
+        (r as u64, super::nzcv(r >> 31 == 1, r == 0, c, v))
+    }
+}
