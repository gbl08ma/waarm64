+/// Runs the decoded block at `key` (its dispatch counted: [`Jit::enter`]) and
+/// the blocks after it ([`decoded`]), and the compiled blocks those reach, as
+/// the dispatcher's loop would: each found in the jump cache, after
+/// [`Jit::fresh`], and the decoded blocks after a compiled one counted as
+/// [`Jit::enter`] counts them. It returns to the dispatcher for what's the
+/// dispatcher's: an exit, the steps run out, a block not in the jump cache
+/// whose decoded block doesn't count its dispatch, a compiled block that
+/// doesn't fit, a tagged PC, a changed regime (`Cpu::dispatch`), a fetch
+/// that would fault, the check mode. Returns what [`steps`] would for those
+/// steps, the table's clock kept as it keeps it; `None` if the first block
+/// would have no instructions.
+///
+/// `next_key` gets the key the dispatcher would look up next, if this found
+/// it (0 otherwise), so that it doesn't make it again.
+///
+/// So a compiled block the interpreter stops before costs one call, not a
+/// trip around the dispatcher's loop each way (bench/interp/REPORT.md "PERF
+/// loop 2").
+///
+/// # Safety
+/// As for [`steps`]: `v` is valid and nothing else references it while this
+/// runs; `R` is its regime (`Cpu::dispatch`) and `key` the block at its PC.
+#[inline(never)]
+unsafe fn interpret<R: Bus>(
+    v: *mut Vcpu,
+    mem: &Mem,
+    key: u64,
+    left: u64,
+    next_key: &mut u64,
+) -> Option<(u64, Option<Exit>)> {
+    let (mut key, mut done) = (key, 0);
+    let regime = if R::MMU { DISPATCH_MMU } else { 0 };
+    loop {
+        *next_key = 0;
+        // SAFETY: guaranteed by the caller; these references end before a
+        // compiled block runs.
+        let vr = unsafe { &mut *v };
+        let t = &mut vr.jit.cache.as_deref_mut().expect("a JIT vCPU").table;
+        let mut m = R::bus(mem, &mut vr.tlb);
+        let Some((k, e)) = decoded(&mut vr.cpu, &mut m, t, mem, key, left - done, next_key) else {
+            // (A block after a compiled one counted its dispatch, so it has instructions.)
+            debug_assert_eq!(done, 0);
+            return (done != 0).then_some((done, None));
+        };
+        t.clock += k;
+        done += k;
+        if e.is_some() || *next_key == 0 || done >= left {
+            return Some((done, e));
+        }
+        // The compiled block it stopped before, and the ones after it.
+        let mut k = *next_key;
+        key = loop {
+            // SAFETY: as above.
+            let vr = unsafe { &mut *v };
+            let jit = vr.jit.cache.as_deref_mut().expect("a JIT vCPU");
+            jit.fresh(mem);
+            let j = jit.table.jc[jc_index(k)];
+            if vr.tlb.xdrops != jit.table.drops {
+                vr.tlb.xdrops = jit.table.drops;
+                vr.tlb.bump();
+            }
+            if j.key != k || j.len as u64 > left - done || jit.table.cfg.check {
+                *next_key = k;
+                return Some((done, None));
+            }
+            if R::MMU {
+                vr.tlb.xc_fill(vr.cpu.pc, k & 3, j.idx, j.len);
+            }
+            // SAFETY: `j` is the jump cache's, so installed in this table; no
+            // reference into `*v` is live (`vr` and `jit` end here).
+            let (n, e) = unsafe { run_block(v, mem, k, j.idx, left - done) };
+            done += n;
+            *next_key = 0;
+            if e.is_some() || done >= left {
+                return Some((done, e));
+            }
+            // The next block's key, as the dispatcher's `key` makes it.
+            // SAFETY: the block has returned.
+            let vr = unsafe { &mut *v };
+            let c = &vr.cpu;
+            let nk = if c.dispatch & (DISPATCH_INTERP | DISPATCH_MMU) == regime {
+                R::bus(mem, &mut vr.tlb).key(c, c.pc)
+            } else {
+                None
+            };
+            let Some(nk) = nk else {
+                return Some((done, None));
+            };
+            let jit = vr.jit.cache.as_deref_mut().expect("a JIT vCPU");
+            jit.fresh(mem);
+            if jit.table.jc[jc_index(nk)].key == nk {
+                k = nk;
+                continue;
+            }
+            let counted = jit.table.dec.count(nk);
+            if vr.tlb.xdrops != jit.table.drops {
+                vr.tlb.xdrops = jit.table.drops;
+                vr.tlb.bump();
+            }
+            if !counted {
+                *next_key = nk;
+                return Some((done, None));
+            }
+            break nk;
+        };
+    }
+}
