+/// Which [`Regime`] [`interpret`] makes over the vCPU's TLB each time it
+/// comes back from a compiled block, and the dispatch bits it's for.
+trait Bus {
+    const MMU: bool;
+    type B<'a>: Regime;
+    fn bus<'a>(mem: &'a Mem, tlb: &'a mut crate::mmu::Tlb) -> Self::B<'a>;
+}
+
+struct FlatBus;
+struct MmuBus;
+
+impl Bus for FlatBus {
+    const MMU: bool = false;
+    type B<'a> = Flat<'a>;
+    #[inline(always)]
+    fn bus<'a>(mem: &'a Mem, _: &'a mut crate::mmu::Tlb) -> Flat<'a> {
+        Flat(mem)
+    }
+}
+
+impl Bus for MmuBus {
+    const MMU: bool = true;
+    type B<'a> = Mmu<'a>;
+    #[inline(always)]
+    fn bus<'a>(mem: &'a Mem, tlb: &'a mut crate::mmu::Tlb) -> Mmu<'a> {
+        Mmu::new(mem, Some(tlb))
+    }
+}
