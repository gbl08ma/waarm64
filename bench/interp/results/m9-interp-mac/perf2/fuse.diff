+/// Runs compiled block `idx` (at `key`) for at most `left` steps and counts
+/// it in the table's statistics and clock: the steps it ran and its exit.
+///
+/// # Safety
+/// As for [`steps`]; `idx` is a compiled block installed in the vCPU's table
+/// (the cache drops blocks, and the blocks chained to them, before it reuses
+/// their slots), and no reference into `*v` is live: the block and its
+/// helpers use the raw pointer.
+#[inline(always)]
+unsafe fn run_block(v: *mut Vcpu, mem: &Mem, key: u64, idx: u32, left: u64) -> (u64, Option<Exit>) {
+    // SAFETY: guaranteed by the caller; the references end before the call.
+    let helped = unsafe {
+        (*v).jit.mem = mem;
+        (*v).jit.helper_steps
+    };
+    let (f, entry) = (idx & IDX_MASK, idx >> ENTRY_SHIFT << emit::ENTRY_BIT);
+    // SAFETY: guaranteed by the caller (`mem` isn't in `*v`).
+    let k = unsafe { block(f)(v, 0, left.min(i32::MAX as u64) as u32, entry) } as u64;
+    // Not at depth 0 (`emit::DEPTH`): a depth that reached a function
+    // with entry bits still set would count ~2^31 steps and end the
+    // chunk, so it stops here instead, named.
+    assert!(
+        k < emit::RETURNED as u64,
+        "block {key:#x} (index {idx:#x}, entry {entry:#x}) returned {k:#x}"
+    );
+    // SAFETY: the block has returned.
+    let vr = unsafe { &mut *v };
+    let jit = vr.jit.cache.as_deref_mut().expect("a JIT vCPU");
+    let e = vr.jit.exit.take();
+    let s = &mut jit.table.stats;
+    let ran = k + e.is_some_and(Exit::retired) as u64;
+    s.dispatches += 1;
+    s.steps += ran;
+    s.inline_steps += ran - (vr.jit.helper_steps - helped);
+    jit.table.clock += k;
+    (k, e)
+}
