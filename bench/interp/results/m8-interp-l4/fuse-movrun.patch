+/// In a flag setter's `x` (ADDS/SUBS, ANDS): the next micro-op is a B.cond,
+/// which [`hot`] takes with it (one dispatch for the pair; [`fuse`]).
+const FUSED: u32 = 1 << 31;
+
+/// Marks the flag setters followed by a B.cond ([`FUSED`]). The B.cond stays
+/// in place: [`run`] ignores the mark, and a prefix that ends between the two
+/// runs the setter alone.
+pub fn fuse(b: &mut [Uop]) {
+    for k in 1..b.len() {
+        if b[k].k == K::Bcond
+            && matches!(b[k - 1].k, K::AddsI | K::AddR | K::AddX | K::LogI | K::LogR)
+        {
+            b[k - 1].x |= FUSED;
+        }
+    }
+}
+
+/// Marks each MovI with the number of MovIs right after it ([`hot`] runs
+/// them in its dispatch; [`run`] ignores the count).
+pub fn mov_runs(b: &mut [Uop]) {
+    let mut n = 0;
+    for k in (0..b.len()).rev() {
+        if b[k].k == K::MovI {
+            b[k].x = n;
+            n += 1;
+        } else {
+            n = 0;
+        }
+    }
+}
