+
+/// LDTR and STTR in the block interpreter's inline paths take EL0's TLB
+/// array at EL1: a page EL1 may read (its EL1 entry cached) but EL0 may not
+/// faults as the interpreter faults; one EL0 may use works.
+#[test]
+fn unprivileged_accesses_in_the_block_interpreter() {
+    use crate::interp::block::{pack, run_hot, uop};
+    let mut p = Pt::new();
+    p.map(0x1000, 3, 0x9000 | PAGE); // EL1 only
+    p.map(0x2000, 3, 0xa000 | PAGE | AP_EL0_RW);
+    p.map(0x3000, 3, 0x3000 | PAGE); // the code
+    p.r.mem.write(0x9010, 8, 0x11).unwrap();
+    p.r.mem.write(0xa010, 8, 0x22).unwrap();
+    // ldtr x1, [x0]; sttr x1, [x0, #8]
+    let words = [0xf840_0801u32, 0xf800_8801];
+    for (k, w) in words.iter().enumerate() {
+        p.r.mem.write(0x3000 + 4 * k as u64, 4, *w as u64).unwrap();
+    }
+    for x0 in [0x1010, 0x2010] {
+        let mut c = cpu();
+        (c.pc, c.x[0]) = (0x3000, x0);
+        let mut want = c.clone();
+        let r = crate::interp::steps(&mut want, &p.r.mem, None, 2);
+        let mut v = Vcpu::new(c.clone());
+        let mut b = Mmu::new(&p.r.mem, Some(&mut v.tlb));
+        // EL1's own read of it first: its entry cached.
+        let _ = b.read(&c, x0, 8);
+        let uops = pack(&words.map(uop));
+        assert_eq!(run_hot(&mut c, &mut b, &uops, 2, 0x3000), r, "{x0:#x}");
+        assert_eq!(c, want, "{x0:#x}");
+    }
+    assert_eq!(p.r.mem.read(0xa018, 8), Ok(0x22));
+}
