+    /// has compiled since (the dispatcher no longer runs them here), cold
+    /// ones, and the micro-ops of blocks dropped before. Starts over instead
+    /// when they'd fill most of it. Starting over every time re-decoded ~3.5M
+    /// blocks a Chromium render (4 tables); twice the arena made its warm
+    /// renders 5–7% faster, but four tables' arenas are already 128 MiB of the
+    /// core's 1 GiB heap (bench/apps/REPORT.md).
+    fn evict(&mut self) {
+        let (slots, epoch) = (&self.slots, self.epoch);
+        let keep = |k: u64, e: &(u32, u32, u16, u32)| e.3 + 1 >= epoch || slots[slot(k)].key == k;
+        let live: usize = (self.map.iter())
