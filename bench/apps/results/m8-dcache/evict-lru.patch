diff --git a/core/src/interp/block/tests.rs b/core/src/interp/block/tests.rs
index 544fc7c..fb0e18a 100644
--- a/core/src/interp/block/tests.rs
+++ b/core/src/interp/block/tests.rs
@@ -261,3 +261,63 @@ fn the_cache_drops_and_starts_over() {
