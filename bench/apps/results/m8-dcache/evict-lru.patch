+
+/// A full arena keeps the blocks dispatched since it last filled and those
+/// in the slots, moved down, and drops the rest and what was dropped before;
+/// it starts over when they'd fill most of it.
+#[test]
+fn a_full_arena_keeps_what_ran_since() {
+    let t = TestRam::new(0x40000);
+    // Two micro-ops each: add x0, x0, #imm; b . (imm: the PA's top bits).
+    let imm = |pa: u64| pa >> 3 & 0xfff;
+    for pa in (0..0x40000).step_by(8) {
+        t.mem.write(pa, 4, 0x9100_0000 | imm(pa) << 10).unwrap();
+        t.mem.write(pa + 4, 4, 0x1400_0000).unwrap();
+    }
+    let mut c = Cache {
+        budget: 24,
+        ..Cache::default()
+    };
+    let get = |c: &mut Cache, pa: u64| {
+        assert_eq!(c.get(pa, &t.mem).unwrap()[0].imm, imm(pa), "{pa:#x}");
+        c.decoded
+    };
+    let far = |pa: u64| pa + 0x10000; // the same slot
+    let (x, a, b, y, d) = (0x2000, 0x1000, 0x3000, 0x4000, 0x5000);
+    assert_eq!(slot(x), slot(far(x)));
+    // Full: x, far(x) (x leaves its slot), a's four blocks, b's six.
+    let blocks = |base: u64, n: u64| (0..n).map(move |i| base + 8 * i);
+    for pa in [x, far(x)]
+        .into_iter()
+        .chain(blocks(a, 4))
+        .chain(blocks(b, 6))
+    {
+        get(&mut c, pa);
+    }
+    c.drop_page(b >> 12);
+    // The first eviction keeps the rest: all of it ran since the start.
+    assert_eq!((get(&mut c, y), c.clears, c.arena.len()), (13, 1, 14));
+    // x runs from the map and leaves its slot again; a+24 leaves its slot.
+    let ran = [x, far(x), far(a + 24)].map(|pa| get(&mut c, pa));
+    assert_eq!(ran, [13, 13, 14]);
+    // Full again with d's four blocks, dropped; then a+24 is cold.
+    blocks(d, 4).for_each(|pa| _ = get(&mut c, pa));
+    c.drop_page(d >> 12);
+    assert_eq!((get(&mut c, y + 8), c.clears, c.arena.len()), (19, 2, 16));
+    for pa in [x, far(x), a, a + 8, a + 16, y, far(a + 24)] {
+        assert_eq!(get(&mut c, pa), 19, "{pa:#x} kept");
+    }
+    assert_eq!(get(&mut c, a + 24), 20);
+    // y out of its slot and back, from the map.
+    assert_eq!((get(&mut c, far(y)), get(&mut c, y)), (21, 21));
+    // The kept blocks are still filed under their page.
+    c.drop_page(a >> 12);
+    assert_eq!(get(&mut c, a + 8), 22);
+    // Most of the arena ran since: it starts over.
+    let mut c = Cache {
+        budget: 8,
+        ..Cache::default()
+    };
+    blocks(a, 5).for_each(|pa| _ = get(&mut c, pa));
+    assert_eq!((c.clears, c.arena.len(), c.map.len()), (1, 2, 1));
+}
