+/// Files `key` under the page of `pa` for the `n` words there (a block never
+/// leaves its page), widening its entry if it has one.
+fn file(pages: &mut Map<Vec<Filed>>, key: u64, pa: u64, n: u32) {
+    let lo = (pa & 0xfff) as u16;
+    let hi = (lo as u32 + 4 * (n + 1)).min(0x1000) as u16;
+    let filed = pages.entry(pa >> 12).or_default();
+    match filed.iter_mut().find(|f| f.key == key) {
+        Some(f) => (f.lo, f.hi) = (f.lo.min(lo), f.hi.max(hi)),
+        None => filed.push(Filed { key, lo, hi }),
+    }
+}
