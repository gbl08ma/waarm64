{
  "name": "waarm64",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gbl08ma/waarm64"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning tools/start.js",
    "typecheck": "tsc --noEmit",
    "svelte-check": "tools/lint/node_modules/.bin/svelte-check --tsconfig ./tsconfig.svelte.json --config ./vite.config.ts --fail-on-warnings --output human",
    "lint": "npm run -s lint:eslint && npm run -s lint:style && npm run -s lint:format",
    "lint:eslint": "node --import ./tools/lint/ts6.ts tools/lint/node_modules/eslint/bin/eslint.js --flag unstable_native_nodejs_ts_config --config tools/lint/eslint.config.ts --suppressions-location tools/lint/eslint-suppressions.json --max-warnings 0 web/app",
    "lint:style": "tools/lint/node_modules/.bin/stylelint --config tools/lint/stylelint.config.ts --max-warnings 0 'web/app/**/*.svelte' web/app/index.html 'web/app/theme/*.css'",
    "lint:format": "tools/lint/node_modules/.bin/prettier --config tools/lint/prettier.config.ts --log-level warn --check 'web/app/**/*.{svelte,ts}'",
    "format": "tools/lint/node_modules/.bin/prettier --config tools/lint/prettier.config.ts --log-level warn --write 'web/app/**/*.{svelte,ts}'",
    "test": "node --disable-warning=ExperimentalWarning --test 'tests/**/*.test.ts'",
    "serve": "node --disable-warning=ExperimentalWarning tools/serve.ts",
    "dist": "node --disable-warning=ExperimentalWarning tools/dist.ts",
    "bench": "node --disable-warning=ExperimentalWarning bench/run.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.2",
    "playwright-core": "^1.64.1",
    "sirv": "^3.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@tabler/icons-svelte-runes": "^3.49.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "fflate": "^0.8.3",
    "i18next": "26.4.7",
    "svelte": "^5.57.2"
  }
}
