{
  "name": "webpc",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gbl08ma/webpc"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning tools/start.js",
    "typecheck": "tsc --noEmit",
    "svelte-check": "tools/svelte-check/node_modules/.bin/svelte-check --tsconfig ./tsconfig.svelte.json --config ./vite.config.ts --fail-on-warnings --output human",
    "test": "node --disable-warning=ExperimentalWarning --test 'tests/**/*.test.ts'",
    "serve": "node --disable-warning=ExperimentalWarning tools/serve.ts",
    "dist": "node --disable-warning=ExperimentalWarning tools/dist.ts",
    "bench": "node --disable-warning=ExperimentalWarning bench/run.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.2",
    "playwright-core": "^1.64.1",
    "sirv": "^3.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "webpc-svelte-check": "file:tools/svelte-check"
  },
  "dependencies": {
    "@tabler/icons-svelte-runes": "^3.49.0",
    "@xterm/xterm": "^6.0.0",
    "fflate": "^0.8.3",
    "i18next": "26.4.7",
    "svelte": "^5.57.2"
  }
}
