#version 450
// VK4 T18: an image that's a corner of its texture (a compressed one padded to whole blocks; here a key's smaller size
// on a plain texture, tests/wgsl.test.ts): its texels wrapped and filtered in the shader, its size asked (o[7]).
layout(local_size_x = 8) in;
layout(set = 0, binding = 0) uniform sampler2D img;
layout(set = 0, binding = 1, std430) buffer Out { vec4 o[8]; };
const float xs[7] = float[](0.1, 0.5, 0.9, 1.1, -0.1, 0.34, 0.5);
void main() {
  uint i = gl_LocalInvocationIndex;
  if (i < 7u)
    o[i] = textureLod(img, vec2(xs[i], 0.1), 0.0);
  else
    o[i] = vec4(textureSize(img, 0), textureSize(img, 1));
}
