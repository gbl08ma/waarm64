#version 450
// VK4 T8: a float texture through what WebGPU's samplers can't say (tests/wgsl.test.ts): border colours and mirror-once
// as the sampler's key says, on a 2×2 image of one row 1.0 and one 0.0 at LOD 0.
layout(local_size_x = 8) in;
layout(set = 0, binding = 0) uniform sampler2D img;
layout(set = 0, binding = 1, std430) buffer Out { vec4 o[8]; };
const float xs[8] = float[](-1.0, -0.125, 0.125, 0.5, 0.875, 1.125, 2.0, -0.75);
void main() {
  uint i = gl_LocalInvocationIndex;
  o[i] = textureLod(img, vec2(xs[i], 0.25), 0.0);
}
