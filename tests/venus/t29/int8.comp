#version 450
// VK4 T29: 8-bit storage (buffers, uniform buffers) and 8-bit and 16-bit integer arithmetic
// (shaderInt8, shaderInt16), at 32 bits in WGSL (tests/wgsl.test.ts).
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer In { uint8_t u[64]; int8_t s[64]; i8vec4 v[64]; } i;
layout(std140, binding = 1) uniform U { uint8_t k; int8_t ks; } u;
layout(std430, binding = 2) buffer Out { uint8_t u[64]; int8_t s[64]; int w[64]; uint x[64]; int16_t h[64]; float f[64]; } o;
void main() {
  uint n = gl_LocalInvocationIndex;
  uint8_t a = i.u[n], b = uint8_t(n * 7u);
  int8_t c = i.s[n];
  o.u[n] = a * b + u.k;
  o.s[n] = c / int8_t(3) - (c >> int8_t(1)) + u.ks;
  i8vec4 v = i.v[n];
  o.w[n] = int(v.x) + int(v.y) * 2 + int(v.z) * 4 + int(v.w) * 8;
  o.x[n] = uint(max(a, b)) | uint(uint8_t(c)) << 8u;
  int16_t h = int16_t(c) * int16_t(300) + int16_t(a);
  o.h[n] = h / int16_t(7) + int16_t(uint16_t(h) % uint16_t(5));
  o.f[n] = float(c) + float(a) * 0.5;
}
