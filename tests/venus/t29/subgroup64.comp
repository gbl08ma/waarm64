#version 450
// VK4 T29: 64-bit subgroup reductions and scans, which WGSL's built-ins don't take: shuffles of words instead
// (tests/wgsl.test.ts).
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_subgroup_extended_types_int64 : require
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Out { u64vec4 r[64]; } o;
void main() {
  uint n = gl_LocalInvocationIndex;
  uint64_t v = (uint64_t(n * 2654435761u) << 32) | uint64_t(n ^ 0x5au);
  o.r[n] = u64vec4(subgroupMax(v), subgroupMin(v), subgroupMul(v | 1ul), subgroupInclusiveAdd(v));
}
