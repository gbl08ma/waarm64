#version 450
// tests/venus-driver.test.ts (misc: mutableViews): an R8G8B8A8 image's views in R32_UINT (wg_test.c's scenario 38): the
// texel (1, 1) of level 0 stored, level 1 read, into the buffer's first word.
layout(local_size_x = 1) in;
layout(set = 0, binding = 0, r32ui) uniform writeonly uimage2D level0;
layout(set = 0, binding = 1) uniform usampler2D level1;
layout(set = 0, binding = 2) buffer B { uint got; } b;
void main() {
  imageStore(level0, ivec2(1, 1), uvec4(0x04030201u));
  b.got = texelFetch(level1, ivec2(0), 0).r;
}
