#version 450
// tests/venus-driver.test.ts (misc: texelStorage; VK3 L7a, the L6b-L7.3 review's finding 2): 8 storage buffers and 3
// uniform texel buffers, within Vulkan's advertised limits, are 11 of WebGPU's storage buffers (vk/driver/wg_test.c's
// scenario 24): refused at pipeline creation where the adapter has fewer, never an invalid submit.
layout(local_size_x = 1) in;
layout(set = 0, binding = 0) buffer B { uint x[]; } b[8];
layout(set = 0, binding = 1) uniform usamplerBuffer t[3];
void main() {
  for (int i = 0; i < 8; i++) b[i].x[0] = texelFetch(t[i % 3], 0).x + uint(i);
}
