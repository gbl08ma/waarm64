#version 450
// tests/venus-driver.test.ts "misc: freedModule": a depth image's texel read through a sampler declared filterable (the
// driver's program variant for depth views), times a specialization constant (another one makes another module).
layout(local_size_x = 1) in;
layout(constant_id = 0) const float scale = 1.0;
layout(set = 0, binding = 0) buffer B { float v[]; } b;
layout(set = 0, binding = 1) uniform sampler2D t;
void main() { b.v[0] = textureLod(t, vec2(0.5), 0.0).r * scale; }
