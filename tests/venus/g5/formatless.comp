#version 450
#extension GL_EXT_shader_image_load_formatted : require
// tests/venus-driver.test.ts (GD G5, wg_test.c 88): storage images declared without a format, each the bound view's:
// `a` an RGBA8 view written, `b` an RG8 view written (words where WebGPU has no such storage texture), `c` an
// R32_SFLOAT view loaded and stored; `a`'s size into the buffer.
layout(local_size_x = 1) in;
layout(set = 0, binding = 0) writeonly uniform image2D a;
layout(set = 0, binding = 1) writeonly uniform image2D b;
layout(set = 0, binding = 2) uniform image2D c;
layout(set = 0, binding = 3) buffer Out { uint v[4]; } o;
void main() {
  imageStore(a, ivec2(1, 0), vec4(1.0, 0.0, 1.0, 1.0));
  imageStore(b, ivec2(0, 1), vec4(0.2, 0.8, 0.0, 0.0));
  imageStore(c, ivec2(1, 1), imageLoad(c, ivec2(1, 1)) * 2.0 + 1.0);
  o.v[0] = uint(imageSize(a).x);
}
