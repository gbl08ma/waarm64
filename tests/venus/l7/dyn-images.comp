#version 450
// An array of storage images indexed dynamically (VK3 L7.1).
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) buffer Sel { uint idx[64]; } sel;
layout(set = 0, binding = 1, r32ui) uniform uimage2D imgs[3];

void main() {
  uint i = gl_LocalInvocationIndex;
  uint k = sel.idx[i];
  ivec2 p = ivec2(gl_LocalInvocationID.xy);
  uint v = imageLoad(imgs[k], p).x;
  imageStore(imgs[(k + 1u) % 3u], p, uvec4(v + imageSize(imgs[k]).x));
}
