#version 450
// tests/wgsl.test.ts: an image loaded and stored (read-write), of the format STORAGE_RW_FORMAT: WebGPU gives
// read-write storage to r32 formats in core, to a few more with texture-formats-tier2, and to no other.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, STORAGE_RW_FORMAT) uniform image2D img;
void main() {
  ivec2 p = ivec2(gl_GlobalInvocationID.xy);
  imageStore(img, p, imageLoad(img, p) + vec4(1.0));
}
