#version 450
// VK4 T48 (vk/driver/wg_test.c 129): a compute pass alone draws two shared (WSI-like) images, RGBA8 and BGRA8.
layout(local_size_x = 4, local_size_y = 4) in;
layout(set = 0, binding = 0) uniform writeonly image2D a;
layout(set = 0, binding = 1) uniform writeonly image2D b;
void main() {
  ivec2 p = ivec2(gl_GlobalInvocationID.xy);
  imageStore(a, p, vec4(0.2, 0.4, 0.6, 1.0));
  imageStore(b, p, vec4(0.8, 0.6, 0.4, 1.0));
}
