#version 450
// tests/venus-driver.test.ts: v[i] = 3i + k, k from the push constants' last 16 bytes (past WebGPU's 64 bytes of
// immediates: read from the driver's push buffer), the storage in set 4 (sets 3 and up share bind group 3).
layout(local_size_x = 64) in;
layout(set = 4, binding = 0) buffer B { uint v[]; } b;
layout(push_constant) uniform P { uvec4 pad[7]; uint k; } pc;
void main() { uint i = gl_GlobalInvocationID.x; b.v[i] = i * 3u + pc.k; }
