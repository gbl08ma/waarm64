#version 450
// Shared memory filling WebGPU's default workgroup storage (16384 bytes) with a barrier under a uniform condition (the
// out-of-context review of L4f, finding 4): the condition's word has no room of its own.
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer O { uint v[]; } o;
shared uint s[4096];
void main() {
  for (uint i = gl_LocalInvocationIndex; i < 4096u; i += 64u) s[i] = i * 3u;
  barrier();
  if (o.v[0] == 0u) {
    barrier();
    o.v[1u + gl_LocalInvocationIndex] = s[4095u - gl_LocalInvocationIndex * 64u];
  }
}
