#version 450
// tests/venus-driver.test.ts (VK4 T38, wg_test.c 110): what T38 offers, from four invocations at once: an R8_UINT storage
// texel buffer's neighbouring texels stored (one word, four invocations), an R8G8B8A8_SRGB storage image stored (by its
// words, encoded), an R5G6B5 one's two texels (16 bits each, one word), an A8_UNORM image sampled (its alpha its
// texture's red), and a 3D image's slices through 2D views (VK_EXT_image_2d_view_of_3d): slice 2 fetched, slice 3 stored.
layout(local_size_x = 4) in;
layout(set = 0, binding = 0, r8ui) writeonly uniform uimageBuffer tb;
layout(set = 0, binding = 1) writeonly uniform image2D srgb;
layout(set = 0, binding = 2) writeonly uniform image2D packed;
layout(set = 0, binding = 3) uniform sampler2D a8;
layout(set = 0, binding = 4) uniform usampler2D slice2;
layout(set = 0, binding = 5, r32ui) writeonly uniform uimage2D slice3;
layout(set = 0, binding = 6) buffer Out { uint v[4]; } o;
void main() {
  const uint i = gl_LocalInvocationID.x;
  imageStore(tb, int(i), uvec4(i + 1u));
  if (i < 2u)
    imageStore(packed, ivec2(i, 0), i == 0u ? vec4(1.0, 0.0, 0.0, 1.0) : vec4(0.0, 1.0, 1.0, 1.0));
  if (i == 0u) {
    imageStore(srgb, ivec2(0), vec4(0.5));
    const vec4 a = texelFetch(a8, ivec2(0), 0);
    o.v[0] = uint(a.a * 255.0 + 0.5);
    o.v[1] = floatBitsToUint(a.r + a.g + a.b);
    o.v[2] = texelFetch(slice2, ivec2(0), 0).x;
    imageStore(slice3, ivec2(0), uvec4(99u));
  }
}
