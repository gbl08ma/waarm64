#version 450
// Signed atomics on shared memory (finding 5): an atomic<i32> array, so that min and max compare signed.
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer Out { int v; } o;
shared int s;
void main() {
  if (gl_LocalInvocationIndex == 0) s = 1000;
  barrier();
  atomicMin(s, int(gl_LocalInvocationIndex) - 32);
  barrier();
  if (gl_LocalInvocationIndex == 0) o.v = s;
}
