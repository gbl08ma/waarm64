#version 450
// Barriers under two uniform conditions (finding 12): one workgroup variable of the translator's for both.
layout(local_size_x = 64) in;
layout(push_constant) uniform P { uint n, m; } p;
layout(set = 0, binding = 0) buffer Out { uint v[]; } o;
shared uint s[64];
void main() {
  s[gl_LocalInvocationIndex] = gl_LocalInvocationIndex;
  if (p.n > 1u) { barrier(); o.v[gl_LocalInvocationIndex] = s[63 - gl_LocalInvocationIndex]; }
  if (p.m > 1u) { barrier(); o.v[gl_LocalInvocationIndex] += s[gl_LocalInvocationIndex]; }
}
