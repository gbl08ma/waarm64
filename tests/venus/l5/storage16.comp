#version 450
// VK3 L5: 16-bit storage without 16-bit arithmetic (every adapter: tests/wgsl.test.ts).
#extension GL_EXT_shader_16bit_storage : require
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer In { float16_t h[64]; f16vec2 h2[64]; uint16_t s[64]; int16_t si[64]; } i;
layout(std430, binding = 1) buffer Out { float16_t h[64]; float f[64]; uint u[64]; int16_t si[64]; } o;
void main() {
  uint n = gl_LocalInvocationIndex;
  float x = float(i.h[n]) * 2.0 + float(i.h2[n].y);
  o.f[n] = x;
  o.h[n] = float16_t(x);
  o.u[n] = uint(i.s[n]) + uint(int(i.si[n]));
  o.si[n] = int16_t(int(i.si[n]) * 3);
}
