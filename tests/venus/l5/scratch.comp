#version 450
// VK3 L5: a function-scope array past 32 bytes indexed dynamically (scratch: its offset is the whole address).
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Out { uvec4 o[]; };
void main() {
  uint n = gl_LocalInvocationIndex;
  uvec4 a[4];
  for (uint i = 0u; i < 4u; i++) a[i] = uvec4(n * 16u + i * 4u) + uvec4(0u, 1u, 2u, 3u);
  o[n] = a[(n + 3u) & 3u];
}
