#version 450
// VK3 L5: every family of subgroup operations the device advertises with WGSL's subgroups (tests/wgsl.test.ts).
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_vote : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_shuffle_relative : require
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_KHR_shader_subgroup_quad : require
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer B { uint u[64]; float f[64]; vec4 v[]; } b;
void main() {
  uint x = b.u[gl_LocalInvocationIndex];
  float y = float(x);
  uvec4 bal = subgroupBallot(x > 3u);
  uint r = gl_SubgroupInvocationID + gl_SubgroupSize + uint(subgroupElect()) + gl_SubgroupID + gl_NumSubgroups;
  r += uint(subgroupAll(x > 1u)) + uint(subgroupAny(x > 2u)) + uint(subgroupAllEqual(x));
  r += subgroupBroadcastFirst(x) + subgroupBroadcast(x, 1u) + subgroupBallotBitCount(bal);
  r += subgroupBallotFindLSB(bal) + subgroupBallotFindMSB(bal) + uint(subgroupBallotBitExtract(bal, 2u));
  r += subgroupBallotInclusiveBitCount(bal) + subgroupBallotExclusiveBitCount(bal) + uint(subgroupInverseBallot(bal));
  r += gl_SubgroupEqMask.x + gl_SubgroupGeMask.y + gl_SubgroupLtMask.z;
  r += subgroupAdd(x) + subgroupMul(x) + subgroupMin(x) + subgroupMax(x) + subgroupAnd(x) + subgroupOr(x) + subgroupXor(x);
  r += uint(subgroupMin(int(x))) + uint(subgroupAnd(x > 5u));
  r += subgroupInclusiveAdd(x) + subgroupExclusiveMul(x) + subgroupInclusiveMax(x) + subgroupExclusiveXor(x);
  r += subgroupClusteredAdd(x, 4u) + subgroupClusteredMin(x, 2u);
  r += subgroupShuffle(x, x & 3u) + subgroupShuffleXor(x, 1u) + subgroupShuffleUp(x, 1u) + subgroupShuffleDown(x, 2u);
  r += subgroupQuadBroadcast(x, 2u) + subgroupQuadSwapHorizontal(x) + subgroupQuadSwapVertical(x) + subgroupQuadSwapDiagonal(x);
  b.f[gl_LocalInvocationIndex] = subgroupAdd(y) + subgroupInclusiveMul(y) + subgroupMax(y);
  b.v[gl_LocalInvocationIndex] = subgroupShuffle(vec4(y), 0u) + subgroupAdd(vec4(y));
  b.u[gl_LocalInvocationIndex] = r;
}
