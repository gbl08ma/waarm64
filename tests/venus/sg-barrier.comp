#version 450
// dEQP-VK's subgroups.basic.compute.subgroupmemorybarriershared, its shape: each subgroup's elected invocation writes
// its subgroup's word of shared memory, then subgroupMemoryBarrierShared(), then every invocation reads that word. WGSL
// has no subgroup barrier: the translator puts a subgroup operation in its place (wgsl_print.c `subgroup_barrier`);
// without it D3D12 on NVIDIA read the word before the write (31 of each 32 invocations). tests/wgsl.test.ts.
#extension GL_KHR_shader_subgroup_basic : require
layout(local_size_x = 32, local_size_y = 2, local_size_z = 1) in;
layout(std430, binding = 0) buffer Out { uint o[]; };
shared uint words[64];
void main() {
  uint n = gl_LocalInvocationIndex, id = gl_SubgroupID, want = 1000u + id + gl_WorkGroupID.x;
  if (subgroupElect())
    words[id] = want;
  subgroupMemoryBarrierShared();
  o[n * 2u] = words[id] == want ? 1000u + id : 0u;
  o[n * 2u + 1u] = id;
}
