#version 450
// tests/venus-driver.test.ts (misc: immutableSampler, sharedSampler, bigUniform; VK3 L7a, the binding review's
// findings 7, 2 and 5; vk/driver/wg_test.c's scenarios 27 to 29): a 4×4 texture whose left half is 0 and right half 1,
// sampled between its texels 1 and 2 (linear: 0.5), through a combined image sampler (binding 0), and through a
// separate sampler (binding 3) that also samples a depth view (binding 2, cleared 0.25); two uniform blocks, one
// declared past its 1 KiB memory, one past maxUniformBufferRange (bindings 4 and 5), read at an index the push
// constants give (0); the mode a specialization constant (0, 1, 2).
layout(local_size_x = 1) in;
layout(set = 0, binding = 0) uniform sampler2D combined;
layout(set = 0, binding = 1) uniform texture2D color;
layout(set = 0, binding = 2) uniform texture2D depth;
layout(set = 0, binding = 3) uniform sampler s;
layout(set = 0, binding = 4) uniform A { uvec4 a[256]; } ua;
layout(set = 0, binding = 5) uniform B { uvec4 b[8192]; } ub;
layout(set = 0, binding = 6) buffer Out { uint o[]; } o;
layout(constant_id = 0) const uint mode = 0;
layout(push_constant) uniform P { uint index; } pc;
void main() {
  const vec2 at = vec2(0.5, 0.5);
  if (mode == 0u) {
    o.o[0] = uint(round(textureLod(combined, at, 0.0).r * 100.0));
  } else if (mode == 1u) {
    o.o[0] = uint(round(textureLod(sampler2D(color, s), at, 0.0).r * 100.0));
    o.o[1] = uint(round(textureLod(sampler2D(depth, s), at, 0.0).r * 100.0));
  } else {
    o.o[0] = ua.a[pc.index].x;
    o.o[1] = ub.b[pc.index].y;
  }
}
