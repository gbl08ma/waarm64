#version 450
// tests/venus-driver.test.ts (misc: texelBuffer): uniform texel buffers of four layouts and a storage texel buffer.
layout(local_size_x = 16) in;
layout(set = 0, binding = 0) uniform samplerBuffer bgra;   // B8G8R8A8_UNORM: a swizzle
layout(set = 0, binding = 1) uniform isamplerBuffer r16;   // R16_SINT: sign extension, half words
layout(set = 0, binding = 2) uniform usamplerBuffer a2;    // A2B10G10R10_UINT_PACK32: packed channels
layout(set = 0, binding = 3) uniform samplerBuffer rgb8;   // R8G8B8_SNORM: 3-byte texels across words
layout(set = 0, binding = 4, rgba16f) uniform writeonly imageBuffer f16;  // R16G16B16A16_SFLOAT
layout(set = 0, binding = 5) buffer Out { uint o[]; };
void main() {
  uint i = gl_LocalInvocationIndex;
  uvec4 a = uvec4(round(texelFetch(bgra, int(i)) * 255.0));
  ivec4 b = texelFetch(r16, int(i));
  uvec4 c = texelFetch(a2, int(i));
  ivec4 d = ivec4(round(texelFetch(rgb8, int(i)) * 127.0));
  for (uint k = 0u; k < 4u; k++) {
    o[i * 16u + k] = a[k];
    o[i * 16u + 4u + k] = uint(b[k]);
    o[i * 16u + 8u + k] = c[k];
    o[i * 16u + 12u + k] = uint(d[k]);
  }
  imageStore(f16, int(i), vec4(float(i), -0.5 * float(i), 0.25, 1.0 + float(i)));
  if (i == 0u) {
    o[256] = uint(textureSize(bgra));
    o[257] = uint(textureSize(rgb8));
    o[258] = uint(imageSize(f16));
    o[259] = uint(texelFetch(r16, 16).x + 7);  // past the view: 0
  }
}
