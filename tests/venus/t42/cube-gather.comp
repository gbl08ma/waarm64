#version 450
// VK4 T42: gathers of a cube bound as its faces (a shadow sample past level 0, a non-seamless sampler, a padded
// image, an integer cube also sampled), from its faces' fetches: inside +X, across its edge to +Z, and at its corner
// with +Y and +Z, where the texel past both edges is the other three's average (OpenGL's recommendation, llvmpipe's).
layout(local_size_x = 3) in;
layout(set = 0, binding = 0) uniform samplerCube img;
layout(set = 0, binding = 1, std430) buffer Out { vec4 o[3]; };
void main() {
  const vec3 at[3] = vec3[3](vec3(1.0, 0.0, 0.0), vec3(1.0, 0.0, 0.99), vec3(1.0, 0.99, 0.99));
  o[gl_LocalInvocationIndex] = textureGather(img, at[gl_LocalInvocationIndex]);
}
