#version 450
// tests/venus-driver.test.ts (misc: manyUniforms): 13 uniform buffers and push constants past the immediates, more
// uniform bindings than WebGPU's 12 a stage (vk/driver/wg_test.c's scenario 23).
layout(local_size_x = 1) in;
layout(set = 0, binding = 0) uniform U { uint k; } u[13];
layout(set = 0, binding = 1) buffer Out { uint b[]; } o;
layout(push_constant) uniform P { uint pad[31]; uint add; } pc;
void main() {
  for (int i = 0; i < 13; i++) o.b[i] = u[i].k + pc.add;
}
