#version 450
// VK3 L7.2: a combined image-sampler sampled at each of a 4x4 image's texel centres (tests/wgsl.test.ts translates it
// with a YCbCr conversion on set 0 binding 0; the driver's test binds an immutable sampler with one there).
layout(local_size_x = 16) in;
layout(set = 0, binding = 0) uniform sampler2D img;
layout(set = 0, binding = 1, std430) buffer Out { vec4 o[16]; };
void main() {
  uint i = gl_LocalInvocationIndex;
  vec2 uv = (vec2(i & 3u, i >> 2) + 0.5) / 4.0;
  o[i] = textureLod(img, uv, 0.0);
}
