+
+/* webpc G2 capture: VTEST_DUMP=<file> appends records {u32 kind, u32 bytes, payload} */
+#include <stdio.h>
+static FILE *wdump_f;
+static void wdump(uint32_t kind, const void *a, uint32_t alen, const void *b, uint32_t blen)
+{
+   if (!wdump_f) {
+      const char *p = getenv("VTEST_DUMP");
+      if (!p) return;
+      wdump_f = fopen(p, "ab");
+      if (!wdump_f) return;
+   }
+   uint32_t h[2] = { kind, alen + blen };
+   fwrite(h, 4, 2, wdump_f);
+   if (alen) fwrite(a, 1, alen, wdump_f);
+   if (blen) fwrite(b, 1, blen, wdump_f);
+   fflush(wdump_f);
+}
 int virgl_renderer_resource_create(struct virgl_renderer_resource_create_args *args,
                                    struct iovec *iov, uint32_t num_iovs)
 {
    TRACE_FUNC();
+   wdump(2, args, sizeof(*args), NULL, 0);
    return virgl_renderer_resource_create_internal(args, iov, num_iovs, NULL);
 }
 
