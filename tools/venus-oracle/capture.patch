diff --git a/src/venus/vkr_capture.c b/src/venus/vkr_capture.c
new file mode 100644
index 00000000..9f0cbace
--- /dev/null
+++ b/src/venus/vkr_capture.c
@@ -0,0 +1,344 @@
+/*
+ * webpc VK0 B capture: see vkr_capture.h.
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "vkr_capture.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "vn_protocol_renderer_dispatches.h"
+
+#include "vkr_context.h"
+#include "vkr_cs.h"
+
+#define CAP_CMD_MAX 512
+#define CAP_PAGE 4096
+
+struct cap_region {
+   uint32_t ctx_id;
+   uint32_t res_id;
+   int kind;
+   uint32_t mem_flags;
+   const uint8_t *ptr;
+   bool own_map;
+   size_t size;
+   uint8_t *shadow;
+   uint64_t changed_total;
+};
+
+static struct {
+   once_flag once;
+   mtx_t mutex;
+   FILE *f;
+   bool on;
+   uint64_t seq;
+
+   uint64_t cmd_count[CAP_CMD_MAX];
+   uint64_t cmd_bytes[CAP_CMD_MAX];
+   uint64_t reply_count[CAP_CMD_MAX];
+   uint64_t reply_bytes[CAP_CMD_MAX];
+   uint64_t src_count[3];
+   uint64_t src_bytes[3];
+   uint64_t ev[VKR_CAPTURE_EV_COUNT];
+
+   struct cap_region *regions;
+   uint32_t region_count;
+   uint32_t region_max;
+} cap = { .once = ONCE_FLAG_INIT };
+
+static _Thread_local int cap_src = VKR_CAPTURE_SRC_VTEST;
+static _Thread_local bool cap_fence;
+static _Thread_local uint32_t cap_cbs;
+
+static void
+cap_init(void)
+{
+   mtx_init(&cap.mutex, mtx_plain);
+   const char *p = getenv("VENUS_DUMP");
+   if (!p || !*p)
+      return;
+   cap.f = fopen(p, "a");
+   if (!cap.f)
+      return;
+   setvbuf(cap.f, NULL, _IOFBF, 1 << 20);
+   cap.on = true;
+}
+
+static inline bool
+cap_enabled(void)
+{
+   call_once(&cap.once, cap_init);
+   return cap.on;
+}
+
+void
+vkr_capture_set_source(enum vkr_capture_source src)
+{
+   cap_src = src;
+}
+
+void
+vkr_capture_event(enum vkr_capture_event ev)
+{
+   if (!cap_enabled())
+      return;
+   mtx_lock(&cap.mutex);
+   cap.ev[ev]++;
+   mtx_unlock(&cap.mutex);
+}
+
+void
+vkr_capture_submit_info(bool fence, uint32_t command_buffers)
+{
+   cap_fence = fence;
+   cap_cbs = command_buffers;
+}
+
+void
+vkr_capture_track(uint32_t ctx_id,
+                  uint32_t res_id,
+                  int kind,
+                  int fd,
+                  const void *data,
+                  size_t size,
+                  uint32_t mem_flags)
+{
+   if (!cap_enabled())
+      return;
+   const uint8_t *ptr = data;
+   bool own_map = false;
+   if (!ptr && fd >= 0) {
+      void *p = mmap(NULL, size, PROT_READ, MAP_SHARED, fd, 0);
+      if (p != MAP_FAILED) {
+         ptr = p;
+         own_map = true;
+      } else {
+         fprintf(stderr, "vkr_capture: res %u (%zu bytes) not mappable here\n", res_id, size);
+      }
+   }
+   uint8_t *shadow = ptr ? malloc(size) : NULL;
+   if (shadow)
+      memcpy(shadow, ptr, size);
+
+   mtx_lock(&cap.mutex);
+   cap.ev[VKR_CAPTURE_EV_BLOB_CREATE]++;
+   if (cap.region_count == cap.region_max) {
+      cap.region_max = cap.region_max ? cap.region_max * 2 : 64;
+      cap.regions = realloc(cap.regions, sizeof(*cap.regions) * cap.region_max);
+   }
+   cap.regions[cap.region_count++] = (struct cap_region){
+      .ctx_id = ctx_id,
+      .res_id = res_id,
+      .kind = kind,
+      .mem_flags = mem_flags,
+      .ptr = shadow ? ptr : NULL,
+      .own_map = own_map,
+      .size = size,
+      .shadow = shadow,
+   };
+   fprintf(cap.f,
+           "{\"k\":\"blob\",\"ctx\":%u,\"res\":%u,\"kind\":%d,\"size\":%zu,\"flags\":%u,"
+           "\"tracked\":%d}\n",
+           ctx_id, res_id, kind, size, mem_flags, shadow ? 1 : 0);
+   fflush(cap.f);
+   mtx_unlock(&cap.mutex);
+}
+
+void
+vkr_capture_untrack(uint32_t ctx_id, uint32_t res_id)
+{
+   if (!cap_enabled())
+      return;
+   mtx_lock(&cap.mutex);
+   for (uint32_t i = 0; i < cap.region_count; i++) {
+      struct cap_region *r = &cap.regions[i];
+      if (r->ctx_id != ctx_id || r->res_id != res_id)
+         continue;
+      cap.ev[VKR_CAPTURE_EV_BLOB_DESTROY]++;
+      if (r->own_map)
+         munmap((void *)r->ptr, r->size);
+      free(r->shadow);
+      cap.regions[i] = cap.regions[--cap.region_count];
+      break;
+   }
+   mtx_unlock(&cap.mutex);
+}
+
+static const char *const ev_names[VKR_CAPTURE_EV_COUNT] = {
+   "vtest_submits", "ring_batches", "ring_wakeups", "ring_notifies",
+   "fences",        "blob_creates", "blob_destroys",
+};
+
+struct cap_diff {
+   uint64_t mapped[2], changed[2], count[2];
+   char *list;
+   size_t list_len;
+};
+
+/* called with cap.mutex held: diff every tracked region against its shadow and update the shadow */
+static void
+cap_diff_locked(struct cap_diff *d)
+{
+   memset(d, 0, sizeof(*d));
+   FILE *m = open_memstream(&d->list, &d->list_len);
+   bool first = true;
+   for (uint32_t i = 0; i < cap.region_count; i++) {
+      struct cap_region *r = &cap.regions[i];
+      const int k = r->kind ? 1 : 0;
+      d->count[k]++;
+      d->mapped[k] += r->size;
+      if (!r->ptr)
+         continue;
+      uint64_t ch = 0;
+      for (size_t off = 0; off < r->size; off += CAP_PAGE) {
+         const size_t n = r->size - off < CAP_PAGE ? r->size - off : CAP_PAGE;
+         if (memcmp(r->ptr + off, r->shadow + off, n)) {
+            memcpy(r->shadow + off, r->ptr + off, n);
+            ch += n;
+         }
+      }
+      d->changed[k] += ch;
+      if (ch) {
+         fprintf(m, "%s[%u,%d,%zu,%llu,%u]", first ? "" : ",", r->res_id, r->kind, r->size,
+                 (unsigned long long)ch, r->mem_flags);
+         first = false;
+      }
+   }
+   fclose(m);
+}
+
+/* called with cap.mutex held: write the record and reset the counters */
+static void
+cap_emit_locked(const char *kind, uint32_t ctx_id, int fence, uint32_t cbs, struct cap_diff *d)
+{
+   FILE *f = cap.f;
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   fprintf(f, "{\"k\":\"%s\",\"seq\":%llu,\"t\":%.3f,\"ctx\":%u,\"fence\":%d,\"cbs\":%u,\"changed\":[%s]",
+           kind, (unsigned long long)cap.seq++, ts.tv_sec * 1e3 + ts.tv_nsec / 1e6, ctx_id, fence, cbs,
+           d->list ? d->list : "");
+   free(d->list);
+   fprintf(f, ",\"mem\":{\"devmem\":[%llu,%llu,%llu],\"shm\":[%llu,%llu,%llu]}",
+           (unsigned long long)d->count[0], (unsigned long long)d->mapped[0],
+           (unsigned long long)d->changed[0], (unsigned long long)d->count[1],
+           (unsigned long long)d->mapped[1], (unsigned long long)d->changed[1]);
+
+   static const char *const src_names[3] = { "vtest", "ring", "indirect" };
+   fprintf(f, ",\"src\":{");
+   for (int s = 0; s < 3; s++)
+      fprintf(f, "%s\"%s\":[%llu,%llu]", s ? "," : "", src_names[s],
+              (unsigned long long)cap.src_count[s], (unsigned long long)cap.src_bytes[s]);
+   fprintf(f, "},\"ev\":{");
+   for (int e = 0; e < VKR_CAPTURE_EV_COUNT; e++)
+      fprintf(f, "%s\"%s\":%llu", e ? "," : "", ev_names[e], (unsigned long long)cap.ev[e]);
+   fprintf(f, "},\"cmds\":{");
+   bool first = true;
+   for (int c = 0; c < CAP_CMD_MAX; c++) {
+      if (!cap.cmd_count[c])
+         continue;
+      fprintf(f, "%s\"%s\":[%llu,%llu]", first ? "" : ",",
+              vn_dispatch_command_name((VkCommandTypeEXT)c),
+              (unsigned long long)cap.cmd_count[c], (unsigned long long)cap.cmd_bytes[c]);
+      first = false;
+   }
+   fprintf(f, "},\"replies\":{");
+   first = true;
+   for (int c = 0; c < CAP_CMD_MAX; c++) {
+      if (!cap.reply_count[c])
+         continue;
+      fprintf(f, "%s\"%s\":[%llu,%llu]", first ? "" : ",",
+              vn_dispatch_command_name((VkCommandTypeEXT)c),
+              (unsigned long long)cap.reply_count[c], (unsigned long long)cap.reply_bytes[c]);
+      first = false;
+   }
+   fprintf(f, "}}\n");
+   fflush(f);
+
+   memset(cap.cmd_count, 0, sizeof(cap.cmd_count));
+   memset(cap.cmd_bytes, 0, sizeof(cap.cmd_bytes));
+   memset(cap.reply_count, 0, sizeof(cap.reply_count));
+   memset(cap.reply_bytes, 0, sizeof(cap.reply_bytes));
+   memset(cap.src_count, 0, sizeof(cap.src_count));
+   memset(cap.src_bytes, 0, sizeof(cap.src_bytes));
+   memset(cap.ev, 0, sizeof(cap.ev));
+}
+
+void
+vkr_capture_context_end(uint32_t ctx_id)
+{
+   if (!cap_enabled())
+      return;
+   struct cap_diff d;
+   mtx_lock(&cap.mutex);
+   cap_diff_locked(&d);
+   cap_emit_locked("end", ctx_id, 0, 0, &d);
+   mtx_unlock(&cap.mutex);
+}
+
+void
+vkr_capture_dispatch(struct vn_dispatch_context *dispatch)
+{
+   if (!cap_enabled()) {
+      vn_dispatch_command(dispatch);
+      return;
+   }
+
+   struct vkr_cs_decoder *dec = (struct vkr_cs_decoder *)dispatch->decoder;
+   struct vkr_cs_encoder *enc = (struct vkr_cs_encoder *)dispatch->encoder;
+   struct vkr_context *ctx = dispatch->data;
+   const uint8_t *c0 = dec->cur;
+   uint32_t type = 0, flags = 0;
+   if (dec->end - c0 >= 8) {
+      memcpy(&type, c0, 4);
+      memcpy(&flags, c0 + 4, 4);
+   }
+   const int src = cap_src;
+   const bool is_submit = type == VK_COMMAND_TYPE_vkQueueSubmit_EXT ||
+                          type == VK_COMMAND_TYPE_vkQueueSubmit2_EXT ||
+                          type == VK_COMMAND_TYPE_vkQueueBindSparse_EXT;
+   const uint8_t *e0 = enc->cur;
+
+   if (type == VK_COMMAND_TYPE_vkExecuteCommandStreamsMESA_EXT)
+      cap_src = VKR_CAPTURE_SRC_INDIRECT;
+   cap_fence = false;
+   cap_cbs = 0;
+
+   /* the guest wrote what this submit reads before it encoded the submit: diff the mapped memory first (lavapipe
+    * runs the submit on its own thread, which may write feedback slots and readbacks right after) */
+   struct cap_diff d;
+   if (is_submit) {
+      mtx_lock(&cap.mutex);
+      cap_diff_locked(&d);
+      mtx_unlock(&cap.mutex);
+   }
+
+   vn_dispatch_command(dispatch);
+   cap_src = src;
+
+   const uint8_t *c1 = dec->cur;
+   const uint8_t *e1 = enc->cur;
+   const uint64_t bytes = c1 >= c0 ? (uint64_t)(c1 - c0) : 0;
+   const uint64_t rbytes =
+      (flags & VK_COMMAND_GENERATE_REPLY_BIT_EXT) && e0 && e1 >= e0 ? (uint64_t)(e1 - e0) : 0;
+
+   mtx_lock(&cap.mutex);
+   if (type < CAP_CMD_MAX) {
+      cap.cmd_count[type]++;
+      cap.cmd_bytes[type] += bytes;
+      if (flags & VK_COMMAND_GENERATE_REPLY_BIT_EXT) {
+         cap.reply_count[type]++;
+         cap.reply_bytes[type] += rbytes;
+      }
+   }
+   cap.src_count[src]++;
+   cap.src_bytes[src] += bytes;
+   if (is_submit)
+      cap_emit_locked("submit", ctx ? ctx->ctx_id : 0, cap_fence ? 1 : 0, cap_cbs, &d);
+   mtx_unlock(&cap.mutex);
+}
diff --git a/src/venus/vkr_capture.h b/src/venus/vkr_capture.h
new file mode 100644
index 00000000..bbe613b0
--- /dev/null
+++ b/src/venus/vkr_capture.h
@@ -0,0 +1,64 @@
+/*
+ * webpc VK0 B capture (tools/venus-oracle/capture.patch): VENUS_DUMP=<file> appends one JSON line per queue
+ * submit with what the renderer decoded since the previous one (commands by name and bytes, by source: vtest
+ * submits, the ring, indirect streams), the replies written, ring and fence events, and the host-visible memory the
+ * guest has mapped and how many of its 4 KiB pages changed. Off (one branch per command) without VENUS_DUMP.
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef VKR_CAPTURE_H
+#define VKR_CAPTURE_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+struct vn_dispatch_context;
+
+enum vkr_capture_source {
+   VKR_CAPTURE_SRC_VTEST = 0,
+   VKR_CAPTURE_SRC_RING = 1,
+   VKR_CAPTURE_SRC_INDIRECT = 2,
+};
+
+enum vkr_capture_event {
+   VKR_CAPTURE_EV_VTEST_SUBMIT,  /* vkr_context_submit_cmd calls: the guest's execbuffer ioctls */
+   VKR_CAPTURE_EV_RING_BATCH,    /* reads of a non-empty ring by the ring thread */
+   VKR_CAPTURE_EV_RING_WAKEUP,   /* the ring thread woken from its idle wait */
+   VKR_CAPTURE_EV_RING_NOTIFY,   /* vkr_ring_notify (vkNotifyRingMESA) */
+   VKR_CAPTURE_EV_FENCE,         /* vkr_context_submit_fence: the virtio fences */
+   VKR_CAPTURE_EV_BLOB_CREATE,
+   VKR_CAPTURE_EV_BLOB_DESTROY,
+   VKR_CAPTURE_EV_COUNT,
+};
+
+void
+vkr_capture_dispatch(struct vn_dispatch_context *dispatch);
+
+void
+vkr_capture_set_source(enum vkr_capture_source src);
+
+void
+vkr_capture_event(enum vkr_capture_event ev);
+
+/* a queue submit's fence and command buffer count, from vkr_queue.c */
+void
+vkr_capture_submit_info(bool fence, uint32_t command_buffers);
+
+/* kind 0: device memory exported mappable (fd: its dma-buf or shm fd, mapped read-only here); kind 1: shm (data) */
+void
+vkr_capture_track(uint32_t ctx_id,
+                  uint32_t res_id,
+                  int kind,
+                  int fd,
+                  const void *data,
+                  size_t size,
+                  uint32_t mem_flags);
+
+void
+vkr_capture_untrack(uint32_t ctx_id, uint32_t res_id);
+
+void
+vkr_capture_context_end(uint32_t ctx_id);
+
+#endif /* VKR_CAPTURE_H */
