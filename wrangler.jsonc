// The page at waarm64.com (docs/frontend.md "Deployed at waarm64.com"): a Worker with static assets only, no script,
// serving `npm run dist`'s target/dist (its `_headers` gives cross-origin isolation).
{
  "name": "waarm64",
  "compatibility_date": "2026-10-23",
  "assets": { "directory": "./target/dist", "html_handling": "auto-trailing-slash", "not_found_handling": "none" },
  "routes": [{ "pattern": "waarm64.com", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false
}
