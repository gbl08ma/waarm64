// The page at vm.tny.im (docs/frontend.md "Deployed at vm.tny.im"): a Worker with static assets only, no script,
// serving `npm run dist`'s target/dist (its `_headers` gives cross-origin isolation).
{
  "name": "webpc",
  "compatibility_date": "2026-10-23",
  "assets": { "directory": "./target/dist", "html_handling": "auto-trailing-slash", "not_found_handling": "none" },
  "routes": [{ "pattern": "vm.tny.im", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false
}
