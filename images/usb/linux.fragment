# The USB test kernel (docs/usb.md; images/build.sh linux-usb): allnoconfig +
# images/linux.fragment + these. The host side of USB with the platform xHCI driver
# (the DT's generic-xhci node), usbfs (always in USB) for testusb, and usbtest for
# Gadget Zero; new devices announced on the console.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_TEST=y
# The same kernel on QEMU's qemu-xhci (the oracle, docs/usb.md): PCI with the generic ECAM host
# bridge and the xHCI's PCI glue. Our machine has no PCI node, so they stay idle there.
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_PCI=y
