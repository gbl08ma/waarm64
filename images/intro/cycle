#!/bin/sh
# cycle: one toy after another on the screen, 20 s each, starting from the one that runs now
# (images/intro/init starts it after the tour). It stops once somebody starts a toy by hand:
# /tmp/toy (the toys' own note of who has the screen) then names a process that isn't cycle's.
mine=
while :; do
  sleep 20
  now=$(cat /tmp/toy 2>/dev/null)
  [ -z "$mine" ] || [ "$now" = "$mine" ] || exit 0
  case $(cat "/proc/$now/comm" 2>/dev/null) in
    scope) next=ridges ;;
    ridges) next=life ;;
    *) next=scope ;;
  esac
  $next &
  mine=$!
done
