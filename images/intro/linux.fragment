# The introduction's guest (images/build.sh intro; docs/images.md "intro"): allnoconfig plus
# these and nothing of images/linux.fragment. One file served with the page, so it has only what
# its picture and its shell need: our platform (GICv3, the arch timer, PSCI, PL011), a simple
# framebuffer through fbdev, an initramfs built in (images/build.sh adds CONFIG_INITRAMFS_SOURCE)
# and left uncompressed (the file is compressed whole), proc, sysfs and tmpfs. No block layer, no
# network, no virtio, no modules, no VT (nothing draws the boot log on the screen).
# EXPERT makes the rest answerable, and allnoconfig answers it no: kallsyms, BUG's tables, core
# dumps, io_uring and the like.
CONFIG_EXPERT=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_39=y
CONFIG_NR_CPUS=2
CONFIG_HZ_100=y
# An idle guest sleeps until its next timer, so a waiting shell costs the tab nothing.
CONFIG_NO_HZ_IDLE=y
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_PSCI_FW=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_COMPRESSION_NONE=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_FB_SIMPLE=y
# For size: 14% fewer bytes on the wire (1.74 MB gzipped against 2.02), and 12% more steps to
# the first picture (26.7M against 23.7M), which is ~10 ms (bench/demo/REPORT.md "INTRO loop 1").
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
