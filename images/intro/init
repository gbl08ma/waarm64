#!/bin/sh
# The introduction's guest (images/build.sh intro): the first picture before anything else, then
# the tour (/usr/bin/tour), then a shell on the serial console for as long as the visitor wants one.
# waarm64.cols= and waarm64.rows= on the command line are the page's terminal.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin:/toys HOME=/root TERM=xterm-256color
# (The kernel mounts devtmpfs by itself only on a root it mounts, not on an initramfs.)
mount -t devtmpfs dev /dev
mount -t tmpfs tmp /tmp
/toys/scope &
mount -t proc proc /proc
mount -t sysfs sys /sys
hostname waarm64
cols=80 rows=24
for a in $(cat /proc/cmdline); do
  case $a in
    waarm64.cols=*) cols=${a#*=} ;;
    waarm64.rows=*) rows=${a#*=} ;;
  esac
done
stty cols "$cols" rows "$rows"
cd /root
tour
cycle &
# BusyBox's poweroff, halt and reboot ask PID 1, which is this script, by a signal.
trap 'poweroff -f' USR1 USR2
trap 'reboot -f' TERM
# The shell, in a session of its own with the serial port as its terminal (session.c); again if
# it exits. In the background and waited for, so that a signal's trap runs at once.
while :; do
  session &
  wait $!
  sleep 1
done
