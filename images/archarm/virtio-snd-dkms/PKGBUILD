# virtio-snd-dkms (docs/audio.md "Decisions"): the virtio-snd driver (Linux's sound/virtio, GPL-2.0+) for kernels
# that don't build CONFIG_SND_VIRTIO, as Arch Linux ARM's linux-aarch64 doesn't. DKMS builds it for every kernel whose
# headers are installed, and again at each kernel update (its pacman hook). The driver's source is one stable release's
# sound/virtio, fetched file by file from git.kernel.org at makepkg time (nothing of it is in webpc's repo); a kernel
# API change that breaks it shows at the upgrade, as a DKMS build failure: then move pkgver to a newer tag (and the sums).
# Built and checked by images/archarm/virtio-snd-dkms.sh; images/archarm/desktop.sh installs it in the desktop image.
#   makepkg -s && sudo pacman -U virtio-snd-dkms-*.pkg.tar.*
pkgname=virtio-snd-dkms
pkgver=7.2.9
pkgrel=1
pkgdesc='VirtIO sound driver (virtio_snd) built by DKMS, for kernels without CONFIG_SND_VIRTIO'
arch=('any')
url='https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/tree/sound/virtio'
license=('GPL-2.0-or-later')
depends=('dkms')
_files=(Makefile virtio_card.c virtio_card.h virtio_chmap.c virtio_ctl_msg.c virtio_ctl_msg.h virtio_jack.c virtio_kctl.c
  virtio_pcm.c virtio_pcm.h virtio_pcm_msg.c virtio_pcm_ops.c)
source=(dkms.conf)
for _f in "${_files[@]}"; do
  source+=("$_f::https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/plain/sound/virtio/$_f?h=v$pkgver")
done
sha256sums=('07adee27e3757f8f7ffd56c9b1d0d683293ec727db256aeb544abbb5482cfc89'
  '9379a64396372c4e523a71613faeabf211e7ad8a9087101819daeed8d659180a'
  '610d12cdd57143c13fd35118938e288fa53b7a2e4105894fae1de651bbc1c3d4'
  '79eb9974ae93ced665d6bffa8d766ff0cb9a779618112e7c21e37191955274cc'
  '2c6ae3de0f67ee85842296a5205c276421678dcde0d7189e232dbaf0e53ee128'
  '74c21a7a505f37c36ec970fa75447c0ab32671a24bd94873517234f477ab3222'
  'a2e195d6a483df6ceea164e43f4f274a2eab4779c16408fee7f4d8475c885e9f'
  '58776791a4fdf2b216346d93b12be6833be7a159fa4acae3448e357b44612a8a'
  'dc50cff4758fd5111b2616dcc7df85a70e37a739a944472ae8218f68c2ec67e0'
  '6da0817073a496345d00538b4d1e291cd4996249678881b72c3838dba61e9a1a'
  '24de4b5cdbc1f225befebbc2a43fb46f6d966171e8789ec5ca27a3083620ed02'
  'b8f7ecb55c00ba1ab0cf41c656644729f4b73f337932b26fc38e6cab9d5174b5'
  'ad567fefbfa0f51b30f7951aa61f24169a3025256e888268c218da7f0c2117b8')

package() {
  local dst="$pkgdir/usr/src/virtio-snd-$pkgver"
  install -Dm644 dkms.conf "$dst/dkms.conf"
  sed -i "s/@PKGVER@/$pkgver/" "$dst/dkms.conf"
  for _f in "${_files[@]}"; do
    install -m644 "$_f" "$dst/$_f"
  done
}
