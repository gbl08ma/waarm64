#!/bin/sh
# webpc's llvmpipe benchmark (docs/benchmarking.md): the GL image's local.d script. glcomp
# composites like a Wayland compositor on Mesa's software rasterizer, without a display, and
# prints "webpc: <phase> start/end" for the host to time: warm (the shaders compiled by LLVM,
# 3 frames), frames (the timed ones). webpc.lp=N sets LP_NUM_THREADS (0: rasterize on the
# calling thread; Mesa's default is a thread per CPU); webpc.gl=frames,quads,width,height; webpc.gldump=1 prints
# the last frame's pixels (the virgl renderer's reference, tests/virgl/); webpc.glq=frames,queries,width,height runs
# glquery instead (occlusion queries waited on each frame: bench/gpu/query-wait.ts).
# webpc.gpu=1: the machine has a virtio-gpu with virgl (G2): load its driver, so Mesa's EGL finds the
# render node and draws through virgl instead of llvmpipe. In alpine-virgl, glcomp runs on the Mesa in
# /opt/mesa (llvmpipe and virgl from one build: images/build.sh).
exec > /dev/console 2>&1
lp=$(sed -n 's/.*webpc\.lp=\([0-9]*\).*/\1/p' /proc/cmdline)
args=$(sed -n 's/.*webpc\.gl=\([0-9,]*\).*/\1/p' /proc/cmdline | tr , ' ')
echo "webpc: alpine-gl $(cat /etc/alpine-release) $(uname -r) lp=${lp:-default}"
[ -n "$lp" ] && export LP_NUM_THREADS=$lp
[ -d /opt/mesa/lib ] && export LD_LIBRARY_PATH=/opt/mesa/lib
if grep -q 'webpc\.gpu=1' /proc/cmdline; then
  modprobe virtio-gpu
  n=0; while [ ! -e /dev/dri/renderD128 ] && [ $n -lt 100 ]; do sleep 0.1; n=$((n + 1)); done
  ls /dev/dri
fi
glq=$(sed -n 's/.*webpc\.glq=\([0-9,]*\).*/\1/p' /proc/cmdline | tr , ' ')
dump=$(sed -n 's/.*webpc\.gldump=\([0-9]*\).*/\1/p' /proc/cmdline)
if [ -n "$glq" ]; then /usr/local/bin/glquery $glq; else /usr/local/bin/glcomp $args $dump; fi
echo "webpc: test ok"
poweroff
