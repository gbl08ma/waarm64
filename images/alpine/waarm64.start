#!/bin/sh
# waarm64's Alpine boot test (M4 step 4): OpenRC's local service runs this at the
# end of the default runlevel; the runner checks these lines on the console
# (written there directly: OpenRC hides local.d output unless rc_verbose).
exec > /dev/console 2>&1
echo "waarm64: alpine $(cat /etc/alpine-release) $(uname -r)"
grep ' / ' /proc/mounts
echo "waarm64: modules $(lsmod | cut -d' ' -f1 | grep -E '^(virtio_mmio|virtio_blk|ext4)$' | sort | tr '\n' ' ')"
# M4 step 6: linux-virt's modules for the other devices, if the VM has them
# (the runners' test devices: net on the loopback adapter, 9p, input, a framebuffer).
if [ -e /sys/bus/virtio/devices/virtio3 ]; then
  modprobe -a virtio_net 9pnet_virtio 9p virtio_input evdev simpledrm
  ip link set eth0 up
  ip addr add 10.0.2.15/24 dev eth0
  ping -c 1 10.0.2.2 | grep transmitted
  mount -t 9p -o trans=virtio,version=9p2000.L host /mnt
  echo "waarm64: 9p $(cat /mnt/hello.txt)"
  umount /mnt
  grep '^N:' /proc/bus/input/devices
  echo "waarm64: drm $(cat /sys/class/drm/card0-*/modes | head -1)"
fi
echo "waarm64: test ok"
poweroff
