#!/bin/sh
# waarm64's JIT-in-a-JIT benchmark (docs/benchmarking.md "The paired A/B"): the node image's local.d script. Node runs
# jitjit.js, whose work is V8 writing, patching and discarding machine code that the emulator's JIT then compiles;
# "waarm64: node start/end" for the host to time, and jitjit's check line. waarm64.jj=N scales its work (default 100).
exec > /dev/console 2>&1
echo "waarm64: alpine-node $(cat /etc/alpine-release) $(uname -r) node $(node --version)"
n=$(sed -n 's/.*waarm64\.jj=\([0-9]*\).*/\1/p' /proc/cmdline)
echo "waarm64: node start"
node /usr/local/share/waarm64/jitjit.js "${n:-100}" && ok=1
echo "waarm64: node end"
[ -n "$ok" ] && echo "waarm64: test ok"
poweroff
