#!/bin/busybox sh
# The litmus image's init: runs /litmus/run.sh on every CPU the kernel brought
# up and powers off. waarm64.litmus=<options, commas for spaces> on the kernel
# command line passes options to the tests (e.g. waarm64.litmus=-s,1000,-r,2).
# waarm64.stress=<options> runs the atomics stress (stress-lse, then
# stress-llsc; e.g. waarm64.stress=-n,10000,count) instead, or after the litmus
# tests if waarm64.litmus= is there too.
/bin/busybox --install -s
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
mount -t proc proc /proc
mount -t tmpfs tmpfs /tmp
arg() { sed -n "s/.*waarm64\.$1=\([^ ]*\).*/\1/p" /proc/cmdline | tr , ' '; }
given() { grep -q "waarm64\.$1=" /proc/cmdline; }
ok=1
if given litmus || ! given stress; then
  opts=$(arg litmus)
  echo "waarm64: litmus on $(nproc) CPUs: $opts"
  # shellcheck disable=SC2086
  /litmus/run.sh $opts || ok=
fi
if given stress; then
  opts=$(arg stress)
  echo "waarm64: stress on $(nproc) CPUs: $opts"
  for v in lse llsc; do
    echo "stress: $v"
    # shellcheck disable=SC2086
    /litmus/stress-$v $opts || { echo "stress: $v FAILED"; ok=; }
  done
fi
if [ -n "$ok" ]; then echo "waarm64: test ok"; else echo "waarm64: test FAILED"; fi
poweroff -f
