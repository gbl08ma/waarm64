#!/bin/sh
# webpc test guest's init (root on /dev/vda, read-only; the kernel mounted
# devtmpfs): mount the pseudo filesystems, run the test script, report, power
# off (PSCI SYSTEM_OFF).
mount -t proc proc /proc
mount -t sysfs sysfs /sys
echo "webpc: init"
/test.sh
echo "webpc: test exit $?"
poweroff -f
