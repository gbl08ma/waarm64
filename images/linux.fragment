# Linux 6.18 for webpc: allnoconfig plus these (images/build.sh checks that each
# one took effect). Our platform only: arm64 4K pages and 48-bit VA, GICv2 and GICv3 (M7),
# PL011 with earlycon, the arch timer, PSCI, initrd support; printk, devtmpfs
# (mounted by the kernel: the root filesystem has an empty /dev); virtio-mmio
# with the console, entropy and block devices, and ext4 for the root on
# /dev/vda (M4 steps 2-3). No modules: at interpreter speed, boot time is what
# this costs (images/build.sh also builds arm64 defconfig + this fragment).
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_HZ_100=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_TTY=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_PSCI_FW=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
# M4 step 6: virtio-net with IPv4 (BusyBox ip and ping), 9p over virtio,
# virtio-input with evdev, and fbdev on a simple-framebuffer (no fbcon: drawing
# the boot log would cost the boot test).
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_9P_FS=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_VIRTIO_INPUT=y
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_FB_SIMPLE=y
# M4 step 7: SysV IPC, which fio needs (shared memory for its job state).
CONFIG_SYSVIPC=y
