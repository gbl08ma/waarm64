# The LTP guest (M4 step 7): images/buildroot.defconfig plus these. LTP from
# Buildroot's package, pruned to images/ltp/tests by post-build.sh; build.sh
# adds the arm64 kernel selftests. It boots linux/Image-defconfig. Left out of
# the list: tests that need a block device (LTP makes a 300 MB loop device and
# a filesystem of every kind on it: getdents01, rename01 and the like).
BR2_PACKAGE_LTP_TESTSUITE=y
# post-build.sh would delete the Open POSIX testsuite from the image anyway.
# BR2_PACKAGE_LTP_TESTSUITE_OPEN_POSIX is not set
BR2_ROOTFS_OVERLAY="$(WEBPC_IMAGES)/overlay $(WEBPC_IMAGES)/ltp/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(WEBPC_IMAGES)/ltp/post-build.sh"
BR2_TARGET_ROOTFS_EXT2_SIZE="96M"
BR2_TARGET_ROOTFS_EXT2_MKFS_OPTIONS="-O ^64bit -U 77656270-6300-4000-8000-000000000021 -E hash_seed=77656270-6300-4000-8000-000000000022"
