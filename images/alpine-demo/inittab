# /etc/inittab (waarm64's alpine-demo image: images/alpine-demo/inittab): Alpine's own, with root logged in on the
# serial console (the demo's terminal) and a login prompt on the screen's first console.

::sysinit:/sbin/openrc sysinit
::sysinit:/sbin/openrc boot
::wait:/sbin/openrc default

ttyAMA0::respawn:/bin/login -f root
tty1::respawn:/sbin/getty 38400 tty1

::ctrlaltdel:/sbin/reboot
::shutdown:/sbin/openrc shutdown
