+STATIC
+EFI_STATUS
+EFIAPI
 GopSetMode (
   IN  EFI_GRAPHICS_OUTPUT_PROTOCOL  *This,
   IN  UINT32                        ModeNumber
   )
 {
+  EFI_TPL     OldTpl;
+  EFI_STATUS  Status;
+
+  //
+  // At FlushTimer's TPL, so that it sends no request between ours. What the
+  // old mode has waiting is flushed first: the new one is shown whole.
+  //
+  OldTpl = gBS->RaiseTPL (TPL_NOTIFY);
+  GopFlushDirty (VGPU_GOP_FROM_GOP (This));
+  Status = GopSetModeLocked (This, ModeNumber);
+  gBS->RestoreTPL (OldTpl);
+  return Status;
+}
