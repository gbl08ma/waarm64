+//
+// How long a Blt()'s flush waits for the Blt() calls that follow it: a frame.
+//
+#define VGPU_GOP_FLUSH_DELAY  EFI_TIMER_PERIOD_MILLISECONDS (16)
+
+/**
+  Flush the area that Blt() wrote since the last flush, if any. The caller
+  runs at TPL_NOTIFY, so that no other request is in flight.
+**/
 STATIC
 EFI_STATUS
+GopFlushDirty (
+  IN OUT VGPU_GOP  *VgpuGop
+  )
+{
+  if (!VgpuGop->Dirty || VgpuGop->ParentBus->Stopped) {
+    return EFI_SUCCESS;
+  }
+
+  VgpuGop->Dirty = FALSE;
+  return VirtioGpuResourceFlush (
+           VgpuGop->ParentBus,                     // VgpuDev
+           VgpuGop->DirtyX0,                       // X
+           VgpuGop->DirtyY0,                       // Y
+           VgpuGop->DirtyX1 - VgpuGop->DirtyX0,    // Width
+           VgpuGop->DirtyY1 - VgpuGop->DirtyY0,    // Height
+           VgpuGop->ResourceId                     // ResourceId
+           );
+}
+
+VOID
 EFIAPI
+GopFlushTimer (
+  IN EFI_EVENT  Event,
+  IN VOID       *Context
+  )
+{
+  GopFlushDirty (Context);
+}
