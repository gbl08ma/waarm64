{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/cloud-setup.sh", "timeout": 600 } ] }
    ],
    "WorktreeCreate": [
      { "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/worktree-hook.sh create", "timeout": 300 } ] }
    ],
    "WorktreeRemove": [
      { "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/worktree-hook.sh remove", "timeout": 120 } ] }
    ]
  }
}
